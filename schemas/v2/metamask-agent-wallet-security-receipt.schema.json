{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/metamask-agent-wallet-security-receipt.schema.json",
  "title": "IPO.ONE MetaMask Agent Wallet Security Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "securityReceiptHash", "adapterId", "descriptorHash", "capabilitiesHash", "capabilityObservationHash",
    "preparedExecutionHash", "preflightHash", "simulationStatus", "threatStatus", "approvalStatus", "decision",
    "reasonCodes", "observedAt", "expiresAt", "canonicalPreflightStillRequired", "submissionAllowed",
    "externalCallPerformed", "rawProviderResponseRetained", "productionAuthority", "fundsAuthority", "schemaVersion"
  ],
  "properties": {
    "securityReceiptHash": { "$ref": "#/$defs/hash" },
    "adapterId": { "const": "metamask_agent_wallet_reference" },
    "descriptorHash": { "$ref": "#/$defs/hash" },
    "capabilitiesHash": { "$ref": "#/$defs/hash" },
    "capabilityObservationHash": { "$ref": "#/$defs/hash" },
    "preparedExecutionHash": { "$ref": "#/$defs/hash" },
    "preflightHash": { "$ref": "#/$defs/hash" },
    "simulationStatus": { "enum": ["passed", "failed", "unknown"] },
    "threatStatus": { "enum": ["safe", "malicious", "unknown"] },
    "approvalStatus": { "enum": ["not_required", "awaiting_mfa", "approved", "rejected", "unknown"] },
    "decision": { "enum": ["ALLOW", "STEP_UP", "DENY", "QUARANTINE"] },
    "reasonCodes": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$" }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "canonicalPreflightStillRequired": { "const": true },
    "submissionAllowed": { "const": false },
    "externalCallPerformed": { "const": false },
    "rawProviderResponseRetained": { "const": false },
    "productionAuthority": { "const": false },
    "fundsAuthority": { "const": false },
    "schemaVersion": { "const": "metamask_agent_wallet_security_receipt.v1" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
  }
}
