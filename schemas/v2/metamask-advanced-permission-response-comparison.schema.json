{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/metamask-advanced-permission-response-comparison.schema.json",
  "title": "IPO.ONE MetaMask Advanced Permission Response Comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparisonHash", "metaMaskPermissionProjectionHash", "normalizedResponseHash",
    "externalPermissionRefHash", "decision", "reasonCodes", "comparedAt", "activationAllowed",
    "externalProvisioningConfirmed", "rawProviderResponseRetained", "canonicalMutationAllowed",
    "productionAuthority", "fundsAuthority", "schemaVersion"
  ],
  "properties": {
    "comparisonHash": { "$ref": "#/$defs/hash" },
    "metaMaskPermissionProjectionHash": { "$ref": "#/$defs/hash" },
    "normalizedResponseHash": { "$ref": "#/$defs/hash" },
    "externalPermissionRefHash": { "$ref": "#/$defs/hash" },
    "decision": { "enum": ["STEP_UP", "QUARANTINE"] },
    "reasonCodes": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$" }
    },
    "comparedAt": { "type": "string", "format": "date-time" },
    "activationAllowed": { "const": false },
    "externalProvisioningConfirmed": { "const": false },
    "rawProviderResponseRetained": { "const": false },
    "canonicalMutationAllowed": { "const": false },
    "productionAuthority": { "const": false },
    "fundsAuthority": { "const": false },
    "schemaVersion": { "const": "metamask_advanced_permission_response_comparison.v1" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
  }
}
