{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/base-spend-permission-projection.schema.json",
  "title": "IPO.ONE Base Spend Permission Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseSpendPermissionProjectionId", "baseSpendPermissionProjectionHash", "descriptorHash",
    "capabilitiesHash", "capabilityObservationHash", "accountConfigurationHash", "providerRequestId",
    "providerRequestHash", "permissionProjectionHash", "grantHash", "chainId", "contextEpoch",
    "assetRefHash", "targetRefHash", "tokenRefHash", "spenderRefHash", "allowanceMinor", "periodSeconds",
    "validFrom", "validUntil", "canonicalLimitMinor", "canonicalValidFrom", "canonicalExpiresAt",
    "saltHash", "extraDataHash", "exactSpendPermissionHash", "decision",
    "reasonCodes", "preparedAt", "expiresAt", "canonicalAuthorizationStillRequired",
    "humanApprovalRequired", "autoSpendPermissionAllowed", "silentSpendAllowed",
    "subAccountCreationAllowed", "providerAdjustmentAllowed", "walletSendCallsAllowed",
    "ethSendTransactionAllowed", "rawCalldataRetained", "rawSignatureRetained", "externalCallAllowed",
    "activationAllowed", "submissionAllowed", "productionAuthority", "fundsAuthority", "schemaVersion"
  ],
  "properties": {
    "baseSpendPermissionProjectionId": { "$ref": "#/$defs/identifier" },
    "baseSpendPermissionProjectionHash": { "$ref": "#/$defs/hash" },
    "descriptorHash": { "$ref": "#/$defs/hash" },
    "capabilitiesHash": { "$ref": "#/$defs/hash" },
    "capabilityObservationHash": { "$ref": "#/$defs/hash" },
    "accountConfigurationHash": { "$ref": "#/$defs/hash" },
    "providerRequestId": { "$ref": "#/$defs/identifier" },
    "providerRequestHash": { "$ref": "#/$defs/hash" },
    "permissionProjectionHash": { "$ref": "#/$defs/hash" },
    "grantHash": { "$ref": "#/$defs/hash" },
    "chainId": { "const": "eip155:84532" },
    "contextEpoch": { "type": "integer", "minimum": 0 },
    "assetRefHash": { "$ref": "#/$defs/hash" },
    "targetRefHash": { "$ref": "#/$defs/hash" },
    "tokenRefHash": { "$ref": "#/$defs/hash" },
    "spenderRefHash": { "$ref": "#/$defs/hash" },
    "allowanceMinor": { "$ref": "#/$defs/positiveMinor" },
    "periodSeconds": { "type": "integer", "minimum": 1 },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "canonicalLimitMinor": { "$ref": "#/$defs/positiveMinor" },
    "canonicalValidFrom": { "type": "string", "format": "date-time" },
    "canonicalExpiresAt": { "type": "string", "format": "date-time" },
    "saltHash": { "$ref": "#/$defs/hash" },
    "extraDataHash": { "$ref": "#/$defs/hash" },
    "exactSpendPermissionHash": { "$ref": "#/$defs/hash" },
    "decision": { "enum": ["STEP_UP", "DENY", "QUARANTINE"] },
    "reasonCodes": { "$ref": "#/$defs/reasonCodes" },
    "preparedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "canonicalAuthorizationStillRequired": { "const": true },
    "humanApprovalRequired": { "const": true },
    "autoSpendPermissionAllowed": { "const": false },
    "silentSpendAllowed": { "const": false },
    "subAccountCreationAllowed": { "const": false },
    "providerAdjustmentAllowed": { "const": false },
    "walletSendCallsAllowed": { "const": false },
    "ethSendTransactionAllowed": { "const": false },
    "rawCalldataRetained": { "const": false },
    "rawSignatureRetained": { "const": false },
    "externalCallAllowed": { "const": false },
    "activationAllowed": { "const": false },
    "submissionAllowed": { "const": false },
    "productionAuthority": { "const": false },
    "fundsAuthority": { "const": false },
    "schemaVersion": { "const": "base_spend_permission_projection.v1" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/%-]*$"
    },
    "positiveMinor": { "type": "string", "pattern": "^[1-9][0-9]{0,77}$" },
    "reasonCodes": {
      "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$" }
    }
  }
}
