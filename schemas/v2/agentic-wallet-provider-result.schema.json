{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/agentic-wallet-provider-result.schema.json",
  "title": "IPO.ONE Agentic Wallet Provider Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resultHash",
    "requestId",
    "requestHash",
    "adapterId",
    "operationId",
    "status",
    "reasonCodes",
    "externalState",
    "externalReferenceHash",
    "externalCallPerformed",
    "capabilities",
    "observedAt",
    "adapterAcknowledgementOnly",
    "canonicalMutationAllowed",
    "rawProviderResponseRetained",
    "fundsAuthority",
    "schemaVersion"
  ],
  "properties": {
    "resultHash": { "$ref": "#/$defs/hash" },
    "requestId": { "$ref": "#/$defs/identifier" },
    "requestHash": { "$ref": "#/$defs/hash" },
    "adapterId": { "$ref": "#/$defs/identifier" },
    "operationId": { "$ref": "#/$defs/operation" },
    "status": { "enum": ["succeeded", "rejected", "unavailable", "unknown"] },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$" }
    },
    "externalState": { "$ref": "#/$defs/identifier" },
    "externalReferenceHash": {
      "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
    },
    "externalCallPerformed": { "type": "boolean" },
    "capabilities": {
      "oneOf": [
        { "$ref": "agentic-wallet-provider-capabilities.schema.json" },
        { "type": "null" }
      ]
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "adapterAcknowledgementOnly": { "const": true },
    "canonicalMutationAllowed": { "const": false },
    "rawProviderResponseRetained": { "const": false },
    "fundsAuthority": { "const": false },
    "schemaVersion": { "const": "agentic_wallet_provider_result.v1" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/%-]*$"
    },
    "operation": {
      "enum": [
        "walletDiscoverCapabilities",
        "walletPrepareGrant",
        "walletActivateGrant",
        "walletReadGrant",
        "walletRevokeGrant",
        "walletPrepareExecution",
        "walletApproveExecution",
        "walletSubmitExecution",
        "walletReadExecution"
      ]
    }
  }
}
