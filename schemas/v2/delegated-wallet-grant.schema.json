{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/delegated-wallet-grant.schema.json",
  "title": "IPO.ONE Delegated Wallet Grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grantId", "grantHash", "subjectId", "principalId", "accountBindingId",
    "executionDomain", "adapterId", "mandateId", "mandateHash", "spendPolicyId",
    "spendPolicyHash", "creditLineId", "creditLineHash", "obligationId",
    "obligationHash", "authorizationDecisionId", "authorizationHash",
    "sessionSignerRefHash", "providerId", "chainIds", "assetIds",
    "allowedTargetPolicyIds", "perTxLimitMinor", "rolling24hLimitMinor",
    "aggregateLimitMinor", "obligationLimitMinor", "validFrom", "expiresAt",
    "sessionEpoch", "nonce", "externalPermissionRefHash", "externalPolicyHash",
    "status", "pendingExposureMinor", "sandboxOnly", "productionAuthority",
    "fundsAuthority", "transactionsAllowed", "version", "schemaVersion",
    "createdAt", "updatedAt"
  ],
  "properties": {
    "grantId": { "type": "string", "pattern": "^delegated_wallet_grant_[0-9a-f]{64}$" },
    "grantHash": { "$ref": "#/$defs/bytes32" },
    "subjectId": { "$ref": "#/$defs/id" },
    "principalId": { "$ref": "#/$defs/id" },
    "accountBindingId": { "$ref": "#/$defs/id" },
    "executionDomain": { "const": "evm" },
    "adapterId": { "const": "local_sandbox" },
    "mandateId": { "$ref": "#/$defs/id" },
    "mandateHash": { "$ref": "#/$defs/bytes32" },
    "spendPolicyId": { "$ref": "#/$defs/id" },
    "spendPolicyHash": { "$ref": "#/$defs/bytes32" },
    "creditLineId": { "$ref": "#/$defs/id" },
    "creditLineHash": { "$ref": "#/$defs/bytes32" },
    "obligationId": { "$ref": "#/$defs/id" },
    "obligationHash": { "$ref": "#/$defs/bytes32" },
    "authorizationDecisionId": { "$ref": "#/$defs/id" },
    "authorizationHash": { "$ref": "#/$defs/bytes32" },
    "sessionSignerRefHash": { "$ref": "#/$defs/bytes32" },
    "providerId": { "$ref": "#/$defs/id" },
    "chainIds": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["eip155:84532", "eip155:1952"] } },
    "assetIds": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "allowedTargetPolicyIds": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^execution_target_policy_[0-9a-f]{64}$" } },
    "perTxLimitMinor": { "$ref": "#/$defs/positiveMinor" },
    "rolling24hLimitMinor": { "$ref": "#/$defs/positiveMinor" },
    "aggregateLimitMinor": { "$ref": "#/$defs/positiveMinor" },
    "obligationLimitMinor": { "$ref": "#/$defs/positiveMinor" },
    "validFrom": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "sessionEpoch": { "type": "integer", "minimum": 0 },
    "nonce": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "externalPermissionRefHash": { "oneOf": [{ "$ref": "#/$defs/bytes32" }, { "type": "null" }] },
    "externalPolicyHash": { "oneOf": [{ "$ref": "#/$defs/bytes32" }, { "type": "null" }] },
    "status": { "enum": ["prepared", "active", "revoked", "expired", "quarantined"] },
    "pendingExposureMinor": { "$ref": "#/$defs/minor" },
    "sandboxOnly": { "const": true },
    "productionAuthority": { "const": false },
    "fundsAuthority": { "const": false },
    "transactionsAllowed": { "const": false },
    "version": { "type": "integer", "minimum": 1 },
    "schemaVersion": { "const": "delegated_wallet_grant.v1" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/%-]*$" },
    "minor": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "positiveMinor": { "type": "string", "pattern": "^[1-9][0-9]*$" }
  }
}
