        "actor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "client": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "tenant": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "operation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "service": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25000
        },
        "network": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "account": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "concurrencyLimits": {
