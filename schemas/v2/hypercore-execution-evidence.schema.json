{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/hypercore-execution-evidence.schema.json",
  "title": "IPO.ONE HyperCore Execution Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidenceHash", "facilityId", "facilityHash", "orderIntentId", "orderIntentHash",
    "accountBindingHash", "canonicalAccountAddressHash", "queryAddressHash", "delegateId",
    "delegateHash", "apiWalletAddressHash", "signerReferenceHash", "accountSnapshotHash",
    "riskSnapshotHash", "policyDecisionHash", "executionId", "executionHash", "requestHash",
    "actionKind", "actionHash", "nonce", "nonceState", "resultHash",
    "reconciliationRecordHash", "reconciliationStatus", "riskObservedAt", "riskExpiresAt",
    "observedAt", "accountIdentityIsSigner", "infoQueryUsedSignerAddress",
    "externalSystemQueried", "externalOrderSubmitted", "adapterAcknowledgementIsCanonicalTruth",
    "canonicalLedgerMutationAllowed", "canonicalSettlementConfirmed", "resubmissionAllowed",
    "rawProviderResponseRetained", "rawSignatureRetained", "secretsIncluded",
    "withdrawalAuthority", "transferAuthority", "mainnetAuthority", "productionAuthority",
    "fundsAuthority", "schemaVersion"
  ],
  "properties": {
    "evidenceHash": { "$ref": "#/$defs/hash" },
    "facilityId": { "$ref": "#/$defs/identifier" },
    "facilityHash": { "$ref": "#/$defs/hash" },
    "orderIntentId": { "$ref": "#/$defs/identifier" },
    "orderIntentHash": { "$ref": "#/$defs/hash" },
    "accountBindingHash": { "$ref": "#/$defs/hash" },
    "canonicalAccountAddressHash": { "$ref": "#/$defs/hash" },
    "queryAddressHash": { "$ref": "#/$defs/hash" },
    "delegateId": { "$ref": "#/$defs/identifier" },
    "delegateHash": { "$ref": "#/$defs/hash" },
    "apiWalletAddressHash": { "$ref": "#/$defs/hash" },
    "signerReferenceHash": { "$ref": "#/$defs/hash" },
    "accountSnapshotHash": { "$ref": "#/$defs/hash" },
    "riskSnapshotHash": { "$ref": "#/$defs/hash" },
    "policyDecisionHash": { "$ref": "#/$defs/hash" },
    "executionId": { "$ref": "#/$defs/identifier" },
    "executionHash": { "$ref": "#/$defs/hash" },
    "requestHash": { "$ref": "#/$defs/hash" },
    "actionKind": { "enum": ["order", "reduceOnlyOrder", "cancel", "cancelByCloid", "modify"] },
    "actionHash": { "$ref": "#/$defs/hash" },
    "nonce": { "type": "integer", "minimum": 1 },
    "nonceState": { "enum": ["CONFIRMED", "REJECTED", "UNKNOWN"] },
    "resultHash": { "$ref": "#/$defs/hash" },
    "reconciliationRecordHash": { "$ref": "#/$defs/hash" },
    "reconciliationStatus": { "enum": ["pending", "reconciled", "quarantined", "safe_stop"] },
    "riskObservedAt": { "type": "string", "format": "date-time" },
    "riskExpiresAt": { "type": "string", "format": "date-time" },
    "observedAt": { "type": "string", "format": "date-time" },
    "accountIdentityIsSigner": { "const": false },
    "infoQueryUsedSignerAddress": { "const": false },
    "externalSystemQueried": { "const": false },
    "externalOrderSubmitted": { "const": false },
    "adapterAcknowledgementIsCanonicalTruth": { "const": false },
    "canonicalLedgerMutationAllowed": { "const": false },
    "canonicalSettlementConfirmed": { "const": false },
    "resubmissionAllowed": { "const": false },
    "rawProviderResponseRetained": { "const": false },
    "rawSignatureRetained": { "const": false },
    "secretsIncluded": { "const": false },
    "withdrawalAuthority": { "const": false },
    "transferAuthority": { "const": false },
    "mainnetAuthority": { "const": false },
    "productionAuthority": { "const": false },
    "fundsAuthority": { "const": false },
    "schemaVersion": { "const": "hypercore_execution_evidence.v1" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/%-]*$"
    }
  }
}
