{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/execution-target-policy.schema.json",
  "title": "IPO.ONE Execution Target Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targetPolicyId", "policyHash", "providerId", "chainId", "targetAddress",
    "codeHash", "proxyImplementationHash", "allowedFunctionSelectors",
    "maxNativeValueMinor", "allowedTokenSpenders", "maxTokenAllowanceMinor",
    "approvalMode", "withdrawalAllowed", "transferAllowed",
    "targetVerificationStatus", "transactionsAllowed", "sandboxOnly",
    "productionAuthority", "fundsAuthority", "validFrom", "expiresAt",
    "version", "schemaVersion", "createdAt"
  ],
  "properties": {
    "targetPolicyId": { "type": "string", "pattern": "^execution_target_policy_[0-9a-f]{64}$" },
    "policyHash": { "$ref": "#/$defs/bytes32" },
    "providerId": { "$ref": "#/$defs/id" },
    "chainId": { "enum": ["eip155:84532", "eip155:1952"] },
    "targetAddress": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "codeHash": { "$ref": "#/$defs/bytes32" },
    "proxyImplementationHash": { "oneOf": [{ "$ref": "#/$defs/bytes32" }, { "type": "null" }] },
    "allowedFunctionSelectors": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^0x[0-9a-f]{8}$" }
    },
    "maxNativeValueMinor": { "const": "0" },
    "allowedTokenSpenders": { "type": "array", "maxItems": 0 },
    "maxTokenAllowanceMinor": { "const": "0" },
    "approvalMode": { "const": "none" },
    "withdrawalAllowed": { "const": false },
    "transferAllowed": { "const": false },
    "targetVerificationStatus": { "const": "policy_declared" },
    "transactionsAllowed": { "const": false },
    "sandboxOnly": { "const": true },
    "productionAuthority": { "const": false },
    "fundsAuthority": { "const": false },
    "validFrom": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "version": { "const": 1 },
    "schemaVersion": { "const": "execution_target_policy.v1" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/%-]*$" }
  }
}
