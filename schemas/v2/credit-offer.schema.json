{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/credit-offer.schema.json",
  "title": "IPO.ONE Credit Offer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "creditOfferId",
    "creditOfferHash",
    "termsHash",
    "creditIntentId",
    "subjectId",
    "riskDecisionId",
    "assetId",
    "approvedPrincipalMinor",
    "annualRateBps",
    "originationFeeMinor",
    "repaymentFrequency",
    "installmentCount",
    "firstPaymentAt",
    "maturityAt",
    "disclosureRef",
    "termsVersion",
    "validUntil",
    "reasonCodes",
    "sandboxOnly",
    "productionFundsApproved",
    "status",
    "createdAt",
    "updatedAt",
    "schemaVersion"
  ],
  "properties": {
    "creditOfferId": {
      "type": "string",
      "minLength": 1
    },
    "creditOfferHash": {
      "$ref": "#/$defs/hash"
    },
    "termsHash": {
      "$ref": "#/$defs/hash"
    },
    "creditIntentId": {
      "type": "string",
      "minLength": 1
    },
    "subjectId": {
      "type": "string",
      "minLength": 1
    },
    "riskDecisionId": {
      "type": "string",
      "minLength": 1
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "approvedPrincipalMinor": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 78
    },
    "annualRateBps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "originationFeeMinor": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 78
    },
    "repaymentFrequency": {
      "enum": [
        "weekly",
        "biweekly",
        "monthly",
        "end_of_term"
      ]
    },
    "installmentCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 520
    },
    "firstPaymentAt": {
      "type": "string",
      "format": "date-time"
    },
    "maturityAt": {
      "type": "string",
      "format": "date-time"
    },
    "disclosureRef": {
      "type": "string",
      "minLength": 1
    },
    "termsVersion": {
      "enum": ["credit_terms.v1", "credit_terms.synthetic_secured.v1", "credit_terms.synthetic_fee.v1", "credit_terms.synthetic_fee_hosted.v1"]
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
      }
    },
    "sandboxOnly": {
      "const": true
    },
    "productionFundsApproved": {
      "const": false
    },
    "status": {
      "enum": [
        "offered",
        "accepted",
        "declined",
        "expired",
        "superseded"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "schemaVersion": {
      "const": "credit_offer.v1"
    },
    "collateralTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "chainId",
        "collateralAssetId",
        "collateralDecimals",
        "debtAssetId",
        "principalMinor",
        "requiredAssets",
        "loanToValueBps",
        "liquidationThresholdBps",
        "scenarioPriceUsdWad",
        "policyVersion",
        "source",
        "marketPrice",
        "withdrawable",
        "productionFundsMoved",
        "transactionHash",
        "schemaVersion",
        "termsHash"
      ],
      "properties": {
        "profile": {
          "const": "m2_synthetic_weth_usd_cent.v1"
        },
        "chainId": {
          "const": "eip155:84532"
        },
        "collateralAssetId": {
          "const": "weth"
        },
        "collateralDecimals": {
          "const": 18
        },
        "debtAssetId": {
          "const": "urn:ipo-one:sandbox-asset:usd-cent"
        },
        "principalMinor": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "requiredAssets": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "loanToValueBps": {
          "const": "7500"
        },
        "liquidationThresholdBps": {
          "const": "8000"
        },
        "scenarioPriceUsdWad": {
          "const": "2000000000000000000000"
        },
        "policyVersion": {
          "const": "m2_secured_pool_fixture_policy.v1"
        },
        "source": {
          "const": "deterministic_synthetic_scenario"
        },
        "marketPrice": {
          "const": false
        },
        "withdrawable": {
          "const": false
        },
        "productionFundsMoved": {
          "const": false
        },
        "transactionHash": {
          "type": "null"
        },
        "schemaVersion": {
          "const": "synthetic_collateral_terms.v1"
        },
        "termsHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      }
    },
    "feeTerms": {
      "oneOf": [{ "$ref": "https://schemas.ipo.one/v2/synthetic-fee-terms.schema.json" }, { "$ref": "https://schemas.ipo.one/v2/hosted-synthetic-fee-terms.schema.json" }]
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
  }
}
