{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/m2b-hyperliquid-composition.schema.json",
  "title": "IPO.ONE M2B Hyperliquid Composition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "m2bHyperliquidCompositionId",
    "compositionHash",
    "agentSecuredFacilityAuthorizationId",
    "agentSecuredFacilityAuthorizationHash",
    "agentSecuredFacilityAuthorizationVersion",
    "subjectId",
    "principalId",
    "mandateId",
    "mandateHash",
    "economicAccountBindingId",
    "economicAccountHash",
    "poolObligationBindingId",
    "poolBindingHash",
    "poolProjectionHash",
    "obligationId",
    "obligationHash",
    "tradingFacilityId",
    "facilityHash",
    "facilityStateHash",
    "facilityVersion",
    "hypercoreIntentId",
    "hypercoreIntentHash",
    "economicActionHash",
    "venueAccountBindingId",
    "venueAccountBindingHash",
    "delegateHash",
    "signerReferenceHash",
    "policyConstraintHash",
    "payloadHash",
    "intentKind",
    "environment",
    "market",
    "maxOrderNotionalUsd",
    "launchProfileId",
    "preparedAt",
    "expiresAt",
    "state",
    "version",
    "outcomeHash",
    "observedAt",
    "externalNonceAllocated",
    "signatureCreated",
    "networkCalled",
    "exactExecutionOnly",
    "oneUse",
    "withdrawalAuthority",
    "transferAuthority",
    "leverageChangeAuthority",
    "mainnetAuthority",
    "productionAuthority",
    "realFundsAuthority",
    "schemaVersion"
  ],
  "properties": {
    "m2bHyperliquidCompositionId": { "$ref": "#/$defs/id" },
    "compositionHash": { "$ref": "#/$defs/hash" },
    "agentSecuredFacilityAuthorizationId": { "$ref": "#/$defs/id" },
    "agentSecuredFacilityAuthorizationHash": { "$ref": "#/$defs/hash" },
    "agentSecuredFacilityAuthorizationVersion": { "type": "integer", "const": 1 },
    "subjectId": { "$ref": "#/$defs/id" },
    "principalId": { "$ref": "#/$defs/id" },
    "mandateId": { "$ref": "#/$defs/id" },
    "mandateHash": { "$ref": "#/$defs/hash" },
    "economicAccountBindingId": { "$ref": "#/$defs/id" },
    "economicAccountHash": { "$ref": "#/$defs/hash" },
    "poolObligationBindingId": { "$ref": "#/$defs/id" },
    "poolBindingHash": { "$ref": "#/$defs/hash" },
    "poolProjectionHash": { "$ref": "#/$defs/hash" },
    "obligationId": { "$ref": "#/$defs/id" },
    "obligationHash": { "$ref": "#/$defs/hash" },
    "tradingFacilityId": { "$ref": "#/$defs/id" },
    "facilityHash": { "$ref": "#/$defs/hash" },
    "facilityStateHash": { "$ref": "#/$defs/hash" },
    "facilityVersion": { "type": "integer", "minimum": 1 },
    "hypercoreIntentId": { "$ref": "#/$defs/id" },
    "hypercoreIntentHash": { "$ref": "#/$defs/hash" },
    "economicActionHash": { "$ref": "#/$defs/hash" },
    "venueAccountBindingId": { "$ref": "#/$defs/id" },
    "venueAccountBindingHash": { "$ref": "#/$defs/hash" },
    "delegateHash": { "$ref": "#/$defs/hash" },
    "signerReferenceHash": { "$ref": "#/$defs/hash" },
    "policyConstraintHash": { "$ref": "#/$defs/hash" },
    "payloadHash": { "$ref": "#/$defs/hash" },
    "intentKind": { "const": "open" },
    "environment": { "const": "hyperliquid_testnet" },
    "market": { "const": "BTC" },
    "maxOrderNotionalUsd": { "const": "10" },
    "launchProfileId": { "const": "live_testnet_secured_pool_agent_execution" },
    "preparedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "state": {
      "enum": [
        "PREPARED", "APPROVED", "SIGNING", "SUBMITTING", "SUBMITTED",
        "REJECTED", "UNKNOWN", "RECONCILED", "CLOSED", "ABORTED"
      ]
    },
    "version": { "type": "integer", "minimum": 1 },
    "outcomeHash": {
      "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
    },
    "observedAt": {
      "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "externalNonceAllocated": { "const": false },
    "signatureCreated": { "const": false },
    "networkCalled": { "const": false },
    "exactExecutionOnly": { "const": true },
    "oneUse": { "const": true },
    "withdrawalAuthority": { "const": false },
    "transferAuthority": { "const": false },
    "leverageChangeAuthority": { "const": false },
    "mainnetAuthority": { "const": false },
    "productionAuthority": { "const": false },
    "realFundsAuthority": { "const": false },
    "schemaVersion": { "const": "m2b_hyperliquid_composition.v1" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/%-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    }
  }
}
