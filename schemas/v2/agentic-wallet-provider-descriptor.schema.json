{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/agentic-wallet-provider-descriptor.schema.json",
  "title": "IPO.ONE Agentic Wallet Provider Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptorHash",
    "adapterId",
    "providerFamily",
    "adapterVersion",
    "supportedOperations",
    "enabled",
    "externalCallsEnabled",
    "dynamicallyLoaded",
    "sandboxOnly",
    "productionAuthority",
    "fundsAuthority",
    "schemaVersion"
  ],
  "properties": {
    "descriptorHash": { "$ref": "#/$defs/hash" },
    "adapterId": { "$ref": "#/$defs/identifier" },
    "providerFamily": { "$ref": "#/$defs/identifier" },
    "adapterVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "supportedOperations": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operation" }
    },
    "enabled": { "type": "boolean" },
    "externalCallsEnabled": { "type": "boolean" },
    "dynamicallyLoaded": { "const": false },
    "sandboxOnly": { "const": true },
    "productionAuthority": { "const": false },
    "fundsAuthority": { "const": false },
    "schemaVersion": { "const": "agentic_wallet_provider_descriptor.v1" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/%-]*$"
    },
    "operation": {
      "enum": [
        "walletDiscoverCapabilities",
        "walletPrepareGrant",
        "walletActivateGrant",
        "walletReadGrant",
        "walletRevokeGrant",
        "walletPrepareExecution",
        "walletApproveExecution",
        "walletSubmitExecution",
        "walletReadExecution"
      ]
    }
  }
}
