{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/risk-003b-shadow-run.schema.json",
  "title": "RISK-003B finalized Testnet shadow run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shadowRunId",
    "shadowRunHash",
    "idempotencyIdentity",
    "issueId",
    "mode",
    "status",
    "sourceManifest",
    "featureSnapshot",
    "outcomeLabel",
    "challenger",
    "offlineReport",
    "activePolicyHashBefore",
    "activePolicyHashAfter",
    "activePolicyUnchanged",
    "duplicateDeliveryCount",
    "retryCount",
    "nextRetryAt",
    "economicStateMutation",
    "externalActionPerformed",
    "authorizing",
    "activePolicyMutationAllowed",
    "modelPromotionAllowed",
    "productionAuthority",
    "mainnetAuthority",
    "realValueAuthority",
    "evaluatedAt",
    "schemaVersion"
  ],
  "properties": {
    "shadowRunId": { "$ref": "#/$defs/safeId" },
    "shadowRunHash": { "$ref": "#/$defs/hash" },
    "idempotencyIdentity": { "$ref": "#/$defs/hash" },
    "issueId": { "const": "RISK-003B" },
    "mode": { "const": "shadow" },
    "status": { "const": "succeeded" },
    "sourceManifest": { "$ref": "#/$defs/sourceManifest" },
    "featureSnapshot": { "$ref": "#/$defs/featureSnapshot" },
    "outcomeLabel": { "$ref": "#/$defs/outcomeLabel" },
    "challenger": { "$ref": "#/$defs/challenger" },
    "offlineReport": { "$ref": "#/$defs/offlineReport" },
    "activePolicyHashBefore": { "$ref": "#/$defs/hash" },
    "activePolicyHashAfter": { "$ref": "#/$defs/hash" },
    "activePolicyUnchanged": { "const": true },
    "duplicateDeliveryCount": { "type": "integer", "minimum": 0 },
    "retryCount": { "const": 0 },
    "nextRetryAt": { "type": "null" },
    "economicStateMutation": { "const": false },
    "externalActionPerformed": { "const": false },
    "authorizing": { "const": false },
    "activePolicyMutationAllowed": { "const": false },
    "modelPromotionAllowed": { "const": false },
    "productionAuthority": { "const": false },
    "mainnetAuthority": { "const": false },
    "realValueAuthority": { "const": false },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "schemaVersion": { "const": "risk_003b_shadow_run.v1" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "minor": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$"
    },
    "activePolicySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "policyVersion",
        "authorizationVersion",
        "decisionMode",
        "maximumNotionalUsd",
        "maximumEffectiveLeverage",
        "candidateCommit",
        "authorizingSource"
      ],
      "properties": {
        "policyId": { "$ref": "#/$defs/safeId" },
        "policyVersion": { "$ref": "#/$defs/safeId" },
        "authorizationVersion": { "$ref": "#/$defs/safeId" },
        "decisionMode": { "const": "deterministic_active" },
        "maximumNotionalUsd": { "$ref": "#/$defs/decimal" },
        "maximumEffectiveLeverage": { "type": "number", "minimum": 0 },
        "candidateCommit": { "$ref": "#/$defs/commit" },
        "authorizingSource": { "const": "hl_testnet_001b_exact_run" }
      }
    },
    "sourceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceManifestId",
        "sourceManifestHash",
        "sourceArtifactPath",
        "sourceArtifactSha256",
        "sourceEvidenceHash",
        "sourceIssueId",
        "sourceRunId",
        "sourceMode",
        "sourceCandidateCommit",
        "scope",
        "finality",
        "reconciled",
        "revoked",
        "invalidated",
        "privacyReview",
        "owner",
        "sourceCompletedAt",
        "admittedAt",
        "activePolicyHash",
        "activePolicySnapshot",
        "authorizing",
        "externalActionAllowed",
        "productionAuthority",
        "realValueAuthority",
        "schemaVersion"
      ],
      "properties": {
        "sourceManifestId": { "$ref": "#/$defs/safeId" },
        "sourceManifestHash": { "$ref": "#/$defs/hash" },
        "sourceArtifactPath": {
          "const": "artifacts/testnet/hl-testnet-001b-live-20260901-001.json"
        },
        "sourceArtifactSha256": { "$ref": "#/$defs/sha256" },
        "sourceEvidenceHash": { "$ref": "#/$defs/hash" },
        "sourceIssueId": { "const": "HL-TESTNET-001B" },
        "sourceRunId": { "$ref": "#/$defs/safeId" },
        "sourceMode": { "const": "L3_LIVE_TESTNET" },
        "sourceCandidateCommit": { "$ref": "#/$defs/commit" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subjectReferenceHash",
            "principalReferenceHash",
            "facilityReferenceHash",
            "obligationReferenceHash",
            "authorizationReferenceHash"
          ],
          "properties": {
            "subjectReferenceHash": { "$ref": "#/$defs/hash" },
            "principalReferenceHash": { "$ref": "#/$defs/hash" },
            "facilityReferenceHash": { "$ref": "#/$defs/hash" },
            "obligationReferenceHash": { "$ref": "#/$defs/hash" },
            "authorizationReferenceHash": { "$ref": "#/$defs/hash" }
          }
        },
        "finality": { "const": "finalized" },
        "reconciled": { "const": true },
        "revoked": { "const": false },
        "invalidated": { "const": false },
        "privacyReview": { "const": "passed" },
        "owner": { "const": "risk_operations_shadow_owner" },
        "sourceCompletedAt": { "type": "string", "format": "date-time" },
        "admittedAt": { "type": "string", "format": "date-time" },
        "activePolicyHash": { "$ref": "#/$defs/hash" },
        "activePolicySnapshot": { "$ref": "#/$defs/activePolicySnapshot" },
        "authorizing": { "const": false },
        "externalActionAllowed": { "const": false },
        "productionAuthority": { "const": false },
        "realValueAuthority": { "const": false },
        "schemaVersion": { "const": "risk_003b_source_manifest.v1" }
      }
    },
    "featureSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featureSnapshotId",
        "featureSnapshotHash",
        "sourceManifestHash",
        "decisionCutoffAt",
        "outcomeWindow",
        "decisionFeatures",
        "outcomeFeatures",
        "missingFeatures",
        "dataQuality",
        "futureOutcomeDataIncludedInDecisionFeatures",
        "authorizing",
        "activePolicyMutationAllowed",
        "externalActionAllowed",
        "schemaVersion"
      ],
      "properties": {
        "featureSnapshotId": { "$ref": "#/$defs/safeId" },
        "featureSnapshotHash": { "$ref": "#/$defs/hash" },
        "sourceManifestHash": { "$ref": "#/$defs/hash" },
        "decisionCutoffAt": { "type": "string", "format": "date-time" },
        "outcomeWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startedAt", "finalizedAt"],
          "properties": {
            "startedAt": { "type": "string", "format": "date-time" },
            "finalizedAt": { "type": "string", "format": "date-time" }
          }
        },
        "decisionFeatures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accountEquityBeforeUsd",
            "maximumNotionalUsd",
            "maximumEffectiveLeverage",
            "runCountCap",
            "automaticRetryAllowed"
          ],
          "properties": {
            "accountEquityBeforeUsd": { "$ref": "#/$defs/decimal" },
            "maximumNotionalUsd": { "$ref": "#/$defs/decimal" },
            "maximumEffectiveLeverage": { "type": "number", "minimum": 0 },
            "runCountCap": { "const": 1 },
            "automaticRetryAllowed": { "const": false }
          }
        },
        "outcomeFeatures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "realizedNotionalUsd",
            "utilizationBps",
            "effectiveLeverageBps",
            "repaymentRatioBps",
            "lossRateBps",
            "outstandingPrincipalMinor",
            "realizedPnlMinor",
            "realizedPnlUsd",
            "feeUsd",
            "maximumDrawdownBps",
            "drawdownObservationCount",
            "concentrationBps",
            "manualInterventionCount",
            "unknownOutcomeCount",
            "emergencyCloseCount",
            "reconciliationQualityBps",
            "outcomeWindowMs"
          ],
          "properties": {
            "realizedNotionalUsd": { "$ref": "#/$defs/decimal" },
            "utilizationBps": { "type": "integer", "minimum": 0 },
            "effectiveLeverageBps": { "type": "integer", "minimum": 0 },
            "repaymentRatioBps": { "type": "integer", "minimum": 0 },
            "lossRateBps": { "type": "integer", "minimum": 0 },
            "outstandingPrincipalMinor": { "$ref": "#/$defs/minor" },
            "realizedPnlMinor": { "$ref": "#/$defs/decimal" },
            "realizedPnlUsd": { "$ref": "#/$defs/decimal" },
            "feeUsd": { "$ref": "#/$defs/decimal" },
            "maximumDrawdownBps": { "type": "integer", "minimum": 0 },
            "drawdownObservationCount": { "const": 2 },
            "concentrationBps": { "const": 10000 },
            "manualInterventionCount": { "type": "integer", "minimum": 0 },
            "unknownOutcomeCount": { "const": 0 },
            "emergencyCloseCount": { "type": "integer", "minimum": 0 },
            "reconciliationQualityBps": { "const": 10000 },
            "outcomeWindowMs": { "type": "integer", "minimum": 0 }
          }
        },
        "missingFeatures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeId" }
        },
        "dataQuality": { "const": "limited_single_finalized_testnet_cycle" },
        "futureOutcomeDataIncludedInDecisionFeatures": { "const": false },
        "authorizing": { "const": false },
        "activePolicyMutationAllowed": { "const": false },
        "externalActionAllowed": { "const": false },
        "schemaVersion": { "const": "risk_003b_feature_snapshot.v1" }
      }
    },
    "outcomeLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcomeLabelId",
        "outcomeLabelHash",
        "sourceManifestHash",
        "featureSnapshotHash",
        "label",
        "obligationStatus",
        "creditState",
        "originalPrincipalMinor",
        "repaidPrincipalMinor",
        "outstandingPrincipalMinor",
        "repaymentRatioBps",
        "lossRateBps",
        "defaulted",
        "writtenOff",
        "executionCycleClosed",
        "obligationStillOutstanding",
        "outcomeFinalizedAt",
        "sourceObligationRewritten",
        "authorizing",
        "economicStateMutation",
        "schemaVersion"
      ],
      "properties": {
        "outcomeLabelId": { "$ref": "#/$defs/safeId" },
        "outcomeLabelHash": { "$ref": "#/$defs/hash" },
        "sourceManifestHash": { "$ref": "#/$defs/hash" },
        "featureSnapshotHash": { "$ref": "#/$defs/hash" },
        "label": { "const": "loss_outstanding" },
        "obligationStatus": { "const": "partially_repaid" },
        "creditState": { "const": "LOSS_OUTSTANDING" },
        "originalPrincipalMinor": { "$ref": "#/$defs/minor" },
        "repaidPrincipalMinor": { "$ref": "#/$defs/minor" },
        "outstandingPrincipalMinor": { "$ref": "#/$defs/minor" },
        "repaymentRatioBps": { "type": "integer", "minimum": 0 },
        "lossRateBps": { "type": "integer", "minimum": 0 },
        "defaulted": { "const": false },
        "writtenOff": { "const": false },
        "executionCycleClosed": { "const": true },
        "obligationStillOutstanding": { "const": true },
        "outcomeFinalizedAt": { "type": "string", "format": "date-time" },
        "sourceObligationRewritten": { "const": false },
        "authorizing": { "const": false },
        "economicStateMutation": { "const": false },
        "schemaVersion": { "const": "risk_003b_outcome_label.v1" }
      }
    },
    "challenger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challengerEvaluationId",
        "challengerHash",
        "candidateVersion",
        "baselinePolicyHash",
        "sourceManifestHashes",
        "featureSnapshotHashes",
        "outcomeLabelHashes",
        "completedOutcomeCount",
        "challengerEnabled",
        "evaluationStatus",
        "recommendation",
        "reasonCodes",
        "proposedCapacityMultiplierBps",
        "evaluatedAt",
        "promotionState",
        "promotionAllowed",
        "autoApplied",
        "autoLooseningAllowed",
        "requiresNamedHumanReview",
        "authorizing",
        "activePolicyMutationAllowed",
        "externalActionAllowed",
        "productionAuthority",
        "schemaVersion"
      ],
      "properties": {
        "challengerEvaluationId": { "$ref": "#/$defs/safeId" },
        "challengerHash": { "$ref": "#/$defs/hash" },
        "candidateVersion": { "$ref": "#/$defs/safeId" },
        "baselinePolicyHash": { "$ref": "#/$defs/hash" },
        "sourceManifestHashes": { "$ref": "#/$defs/hashList" },
        "featureSnapshotHashes": { "$ref": "#/$defs/hashList" },
        "outcomeLabelHashes": { "$ref": "#/$defs/hashList" },
        "completedOutcomeCount": { "const": 1 },
        "challengerEnabled": { "type": "boolean" },
        "evaluationStatus": { "enum": ["evaluated", "disabled"] },
        "recommendation": { "enum": ["insufficient_sample", "disabled"] },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeId" }
        },
        "proposedCapacityMultiplierBps": { "type": "null" },
        "evaluatedAt": { "type": "string", "format": "date-time" },
        "promotionState": { "const": "shadow" },
        "promotionAllowed": { "const": false },
        "autoApplied": { "const": false },
        "autoLooseningAllowed": { "const": false },
        "requiresNamedHumanReview": { "const": true },
        "authorizing": { "const": false },
        "activePolicyMutationAllowed": { "const": false },
        "externalActionAllowed": { "const": false },
        "productionAuthority": { "const": false },
        "schemaVersion": { "const": "risk_003b_challenger_evaluation.v1" }
      }
    },
    "offlineReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offlineReportId",
        "offlineReportHash",
        "sourceManifestHashes",
        "featureSnapshotHashes",
        "outcomeLabelHashes",
        "challengerHash",
        "observationWindow",
        "sampleSize",
        "agentSampleCount",
        "humanSampleCount",
        "repaymentRatioBps",
        "outstandingLossOutcomeCount",
        "defaultCount",
        "cureCount",
        "recoveryCount",
        "utilizationBps",
        "concentrationBps",
        "maximumDrawdownBps",
        "calibration",
        "falseApprovalRateBps",
        "falseRejectionRateBps",
        "stability",
        "drift",
        "uncertainty",
        "missingness",
        "activePolicyHashBefore",
        "activePolicyHashAfter",
        "recommendedActivePolicyChange",
        "evaluatedAt",
        "aggregateOnly",
        "participantIdentifiersIncluded",
        "productionValidityClaimed",
        "authorizing",
        "activePolicyMutationAllowed",
        "externalActionAllowed",
        "schemaVersion"
      ],
      "properties": {
        "offlineReportId": { "$ref": "#/$defs/safeId" },
        "offlineReportHash": { "$ref": "#/$defs/hash" },
        "sourceManifestHashes": { "$ref": "#/$defs/hashList" },
        "featureSnapshotHashes": { "$ref": "#/$defs/hashList" },
        "outcomeLabelHashes": { "$ref": "#/$defs/hashList" },
        "challengerHash": { "$ref": "#/$defs/hash" },
        "observationWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startedAt", "finalizedAt"],
          "properties": {
            "startedAt": { "type": "string", "format": "date-time" },
            "finalizedAt": { "type": "string", "format": "date-time" }
          }
        },
        "sampleSize": { "const": 1 },
        "agentSampleCount": { "const": 1 },
        "humanSampleCount": { "const": 0 },
        "repaymentRatioBps": { "type": "integer", "minimum": 0 },
        "outstandingLossOutcomeCount": { "const": 1 },
        "defaultCount": { "const": 0 },
        "cureCount": { "type": "null" },
        "recoveryCount": { "type": "null" },
        "utilizationBps": { "type": "integer", "minimum": 0 },
        "concentrationBps": { "const": 10000 },
        "maximumDrawdownBps": { "type": "integer", "minimum": 0 },
        "calibration": { "const": "unavailable_insufficient_sample" },
        "falseApprovalRateBps": { "type": "null" },
        "falseRejectionRateBps": { "type": "null" },
        "stability": { "const": "unavailable_single_observation" },
        "drift": { "const": "unavailable_no_baseline" },
        "uncertainty": { "const": "very_high_single_testnet_observation" },
        "missingness": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeId" }
        },
        "activePolicyHashBefore": { "$ref": "#/$defs/hash" },
        "activePolicyHashAfter": { "$ref": "#/$defs/hash" },
        "recommendedActivePolicyChange": { "type": "null" },
        "evaluatedAt": { "type": "string", "format": "date-time" },
        "aggregateOnly": { "const": true },
        "participantIdentifiersIncluded": { "const": false },
        "productionValidityClaimed": { "const": false },
        "authorizing": { "const": false },
        "activePolicyMutationAllowed": { "const": false },
        "externalActionAllowed": { "const": false },
        "schemaVersion": { "const": "risk_003b_offline_report.v1" }
      }
    },
    "hashList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hash" }
    }
  }
}
