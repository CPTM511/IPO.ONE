{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/hypercore-stable-policy-constraint.schema.json",
  "title": "HyperCore Stable Policy Constraint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyConstraintHash", "policyId", "policyVersion", "facilityHash",
    "accountBindingHash", "delegateHash", "signerReferenceHash", "environment",
    "market", "productClass", "assetIndex", "sizeDecimals", "priceDecimals",
    "maxOrderNotionalUsd", "maxAggregateProofExposureUsd", "maxOpenOrders",
    "maxSubmissions", "openingTimeInForce", "minimumPostOnlyDistanceBps",
    "maximumPostOnlyDistanceBps", "maxRiskAgeMs", "maxMetadataAgeMs",
    "requestExpiryMs", "executionOwnerActorId", "riskOwnerActorId",
    "incidentOwnerActorId", "withdrawalAuthority", "transferAuthority",
    "leverageChangeAuthority", "accountAdministrationAuthority",
    "mainnetAuthority", "productionAuthority", "realFundsAuthority", "schemaVersion"
  ],
  "properties": {
    "policyConstraintHash": { "$ref": "#/$defs/hash" },
    "policyId": { "$ref": "#/$defs/identifier" },
    "policyVersion": { "$ref": "#/$defs/identifier" },
    "facilityHash": { "$ref": "#/$defs/hash" },
    "accountBindingHash": { "$ref": "#/$defs/hash" },
    "delegateHash": { "$ref": "#/$defs/hash" },
    "signerReferenceHash": { "$ref": "#/$defs/hash" },
    "environment": { "const": "hyperliquid_testnet" },
    "market": { "const": "BTC" },
    "productClass": { "const": "perpetual" },
    "assetIndex": { "const": 3 },
    "sizeDecimals": { "const": 5 },
    "priceDecimals": { "const": 1 },
    "maxOrderNotionalUsd": { "const": "10" },
    "maxAggregateProofExposureUsd": { "const": "10" },
    "maxOpenOrders": { "const": 1 },
    "maxSubmissions": { "const": 1 },
    "openingTimeInForce": { "const": "Alo" },
    "minimumPostOnlyDistanceBps": { "const": 50 },
    "maximumPostOnlyDistanceBps": { "const": 3500 },
    "maxRiskAgeMs": { "const": 10000 },
    "maxMetadataAgeMs": { "const": 300000 },
    "requestExpiryMs": { "const": 30000 },
    "executionOwnerActorId": { "$ref": "#/$defs/identifier" },
    "riskOwnerActorId": { "$ref": "#/$defs/identifier" },
    "incidentOwnerActorId": { "$ref": "#/$defs/identifier" },
    "withdrawalAuthority": { "const": false },
    "transferAuthority": { "const": false },
    "leverageChangeAuthority": { "const": false },
    "accountAdministrationAuthority": { "const": false },
    "mainnetAuthority": { "const": false },
    "productionAuthority": { "const": false },
    "realFundsAuthority": { "const": false },
    "schemaVersion": { "const": "hypercore_stable_policy_constraint.v2" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "identifier": {
      "type": "string", "minLength": 3, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/%-]*$"
    }
  }
}
