{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/synthetic-fee-statement.schema.json",
  "title": "IPO.ONE synthetic-fee-statement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "institutionId",
    "month",
    "periodStart",
    "periodEnd",
    "openingMinor",
    "additionsMinor",
    "reversalsMinor",
    "settledMinor",
    "closingMinor",
    "lines",
    "closed",
    "syntheticOnly",
    "productionFundsMoved",
    "schemaVersion",
    "statementId"
  ],
  "properties": {
    "institutionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "month": {
      "type": "string",
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
    },
    "periodStart": {
      "type": "string",
      "format": "date-time"
    },
    "periodEnd": {
      "type": "string",
      "format": "date-time"
    },
    "openingMinor": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,77})$"
    },
    "additionsMinor": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,77})$"
    },
    "reversalsMinor": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,77})$"
    },
    "settledMinor": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,77})$"
    },
    "closingMinor": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,77})$"
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.ipo.one/v2/synthetic-fee-entry.schema.json"
      }
    },
    "closed": {
      "type": "boolean"
    },
    "syntheticOnly": {
      "const": true
    },
    "productionFundsMoved": {
      "const": false
    },
    "schemaVersion": {
      "const": "synthetic_fee_statement.v1"
    },
    "statementId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    }
  }
}
