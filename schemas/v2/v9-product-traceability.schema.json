{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/v9-product-traceability.schema.json",
  "title": "IPO.ONE V9 product traceability manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "productVersion",
    "status",
    "sourceCommit",
    "prototypeAuthority",
    "classifications",
    "releaseMaturity",
    "sharedContracts",
    "operationBindings",
    "destinations",
    "crossCuttingAreas"
  ],
  "properties": {
    "schemaVersion": { "const": "v9_product_traceability.v1" },
    "product": { "const": "IPO.ONE" },
    "productVersion": { "const": "V9" },
    "status": { "const": "IMPLEMENTED_UNVERIFIED" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "prototypeAuthority": { "const": false },
    "classifications": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/classification" }
    },
    "releaseMaturity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantProtocolMaturity",
        "enabledReleaseProfiles",
        "closedPilotReleaseEnabled",
        "controlledCreditReleaseEnabled",
        "realFundsEnabled",
        "productionCreditEnabled"
      ],
      "properties": {
        "tenantProtocolMaturity": { "const": "local_non_funds" },
        "enabledReleaseProfiles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "prefixItems": [
            { "const": "public_sandbox" },
            { "const": "live_testnet_secured_pool" }
          ],
          "items": false
        },
        "closedPilotReleaseEnabled": { "const": false },
        "controlledCreditReleaseEnabled": { "const": false },
        "realFundsEnabled": { "const": false },
        "productionCreditEnabled": { "const": false }
      }
    },
    "sharedContracts": { "$ref": "#/$defs/sharedContracts" },
    "operationBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operationBinding" }
    },
    "destinations": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/destination" }
    },
    "crossCuttingAreas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/crossCuttingArea" }
    }
  },
  "$defs": {
    "classification": {
      "enum": [
        "REAL_LOCAL",
        "REAL_TESTNET_READ",
        "SIMULATION_ONLY",
        "SPECIFIED_DISABLED",
        "ABSENT"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "pathArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "sharedContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantCatalog",
        "requestSchema",
        "resultSchema",
        "handlerRegistry",
        "authorizationPolicy",
        "admissionPolicy",
        "persistenceComposition",
        "eventOutboxRepository",
        "reconciliationService",
        "launchPolicy"
      ],
      "properties": {
        "tenantCatalog": { "$ref": "#/$defs/path" },
        "requestSchema": { "$ref": "#/$defs/path" },
        "resultSchema": { "$ref": "#/$defs/path" },
        "handlerRegistry": { "$ref": "#/$defs/path" },
        "authorizationPolicy": { "$ref": "#/$defs/path" },
        "admissionPolicy": { "$ref": "#/$defs/path" },
        "persistenceComposition": { "$ref": "#/$defs/path" },
        "eventOutboxRepository": { "$ref": "#/$defs/path" },
        "reconciliationService": { "$ref": "#/$defs/path" },
        "launchPolicy": { "$ref": "#/$defs/path" }
      }
    },
    "operationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "requestSchemaVersion",
        "responseSchemaVersion",
        "handlerModule",
        "authorizationPolicyModule",
        "admissionPolicyModule",
        "persistenceModules",
        "uiAdapters",
        "testFiles"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(pilot|worker|trading|agent|wallet|venue)[A-Z][A-Za-z0-9]*$"
        },
        "requestSchemaVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "responseSchemaVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "handlerModule": { "$ref": "#/$defs/path" },
        "authorizationPolicyModule": { "$ref": "#/$defs/path" },
        "admissionPolicyModule": { "$ref": "#/$defs/path" },
        "persistenceModules": {
          "allOf": [
            { "$ref": "#/$defs/pathArray" },
            { "type": "array", "minItems": 1 }
          ]
        },
        "uiAdapters": {
          "allOf": [
            { "$ref": "#/$defs/pathArray" },
            { "type": "array", "minItems": 1 }
          ]
        },
        "testFiles": {
          "allOf": [
            { "$ref": "#/$defs/pathArray" },
            { "type": "array", "minItems": 1 }
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "label",
        "prototypeLabels",
        "classification",
        "authorityType",
        "operationIds",
        "authorityReferences",
        "uiAdapters",
        "testFiles",
        "truthBoundary",
        "nextTaskIds",
        "humanGateRequired"
      ],
      "properties": {
        "actionId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "prototypeLabels": { "$ref": "#/$defs/stringArray" },
        "classification": { "$ref": "#/$defs/classification" },
        "authorityType": {
          "enum": [
            "tenant_protocol",
            "checked_in_contract",
            "transport_authentication",
            "testnet_read_adapter",
            "none"
          ]
        },
        "operationIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "authorityReferences": { "$ref": "#/$defs/pathArray" },
        "uiAdapters": { "$ref": "#/$defs/pathArray" },
        "testFiles": { "$ref": "#/$defs/pathArray" },
        "truthBoundary": {
          "type": "string",
          "minLength": 16,
          "maxLength": 1000
        },
        "nextTaskIds": { "$ref": "#/$defs/stringArray" },
        "humanGateRequired": { "type": "boolean" }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destinationId", "label", "order", "actions"],
      "properties": {
        "destinationId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "crossCuttingArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["areaId", "label", "actions"],
      "properties": {
        "areaId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    }
  }
}
