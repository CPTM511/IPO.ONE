{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/trading-credit-assessment.schema.json",
  "title": "IPO.ONE Trading Credit Shadow Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessmentId",
    "assessmentHash",
    "subjectId",
    "principalId",
    "accountReferenceHash",
    "accountBindingHash",
    "assetId",
    "policy",
    "status",
    "evidenceDeficiencies",
    "eligibilityFailures",
    "featureSnapshot",
    "featureSnapshotHash",
    "factors",
    "compositeScoreBps",
    "compositeScoreAuthorizing",
    "capacity",
    "proofBundle",
    "evaluatedAt",
    "testnetOnly",
    "shadowOnly",
    "authorizing",
    "creditApproval",
    "fundsAuthority",
    "economicStateMutation",
    "productionAuthority",
    "modelOutput",
    "recommendationOnly",
    "schemaVersion"
  ],
  "properties": {
    "assessmentId": { "$ref": "#/$defs/id" },
    "assessmentHash": { "$ref": "#/$defs/hash" },
    "subjectId": { "$ref": "#/$defs/id" },
    "principalId": { "$ref": "#/$defs/id" },
    "accountReferenceHash": { "$ref": "#/$defs/hash" },
    "accountBindingHash": { "$ref": "#/$defs/hash" },
    "assetId": { "$ref": "#/$defs/assetId" },
    "policy": { "$ref": "#/$defs/policy" },
    "status": {
      "enum": [
        "eligible_shadow",
        "ineligible_shadow",
        "insufficient_evidence"
      ]
    },
    "evidenceDeficiencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reasonCode" }
    },
    "eligibilityFailures": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reasonCode" }
    },
    "featureSnapshot": { "$ref": "#/$defs/featureSnapshot" },
    "featureSnapshotHash": { "$ref": "#/$defs/hash" },
    "factors": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/factor" }
    },
    "compositeScoreBps": { "$ref": "#/$defs/nullableBps" },
    "compositeScoreAuthorizing": { "const": false },
    "capacity": { "$ref": "#/$defs/capacity" },
    "proofBundle": { "$ref": "#/$defs/proofBundle" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "testnetOnly": { "const": true },
    "shadowOnly": { "const": true },
    "authorizing": { "const": false },
    "creditApproval": { "const": false },
    "fundsAuthority": { "const": false },
    "economicStateMutation": { "const": false },
    "productionAuthority": { "const": false },
    "modelOutput": { "const": false },
    "recommendationOnly": { "const": true },
    "schemaVersion": { "const": "trading_credit_assessment.v1" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "assetId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[A-Za-z0-9._%-]+/[a-z0-9-]+:[A-Za-z0-9._%:-]+$"
    },
    "minor": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,77})$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9_]+$"
    },
    "nullableBps": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 10000 },
        { "type": "null" }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyVersion",
        "assetId",
        "assetDecimals",
        "productCapMinor",
        "validFrom",
        "thresholds",
        "factorWeightsBps",
        "capacity",
        "challengerPrior",
        "shadowOnly",
        "authorizing",
        "productionApproved",
        "autoPromotionAllowed",
        "autoLooseningAllowed",
        "fundsAuthority",
        "economicStateMutation",
        "hashAlgorithm",
        "hashDomain",
        "policyHash",
        "schemaVersion"
      ],
      "properties": {
        "policyVersion": { "const": "trading_credit_mvp_shadow.v1" },
        "assetId": { "$ref": "#/$defs/assetId" },
        "assetDecimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "productCapMinor": { "$ref": "#/$defs/minor" },
        "validFrom": { "type": "string", "format": "date-time" },
        "thresholds": { "$ref": "#/$defs/thresholds" },
        "factorWeightsBps": { "$ref": "#/$defs/weights" },
        "capacity": { "$ref": "#/$defs/capacityPolicy" },
        "challengerPrior": { "$ref": "#/$defs/challengerPrior" },
        "shadowOnly": { "const": true },
        "authorizing": { "const": false },
        "productionApproved": { "const": false },
        "autoPromotionAllowed": { "const": false },
        "autoLooseningAllowed": { "const": false },
        "fundsAuthority": { "const": false },
        "economicStateMutation": { "const": false },
        "hashAlgorithm": { "const": "sha3-256" },
        "hashDomain": { "const": "IPO_ONE_DEMO_V1" },
        "policyHash": { "$ref": "#/$defs/hash" },
        "schemaVersion": { "const": "trading_credit_shadow_policy.v1" }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumObservationCount",
        "minimumObservationDays",
        "maximumEvidenceAgeSeconds",
        "maximumDrawdownBps",
        "maximumP95LeverageBps",
        "maximumLiquidationCount",
        "maximumMandateBreachCount",
        "maximumSevereAnomalyCount",
        "minimumCompletedOutcomesForChallenger",
        "challengerDefaultReviewBps"
      ],
      "properties": {
        "minimumObservationCount": {
          "type": "integer",
          "minimum": 1
        },
        "minimumObservationDays": {
          "type": "integer",
          "minimum": 1
        },
        "maximumEvidenceAgeSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maximumDrawdownBps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maximumP95LeverageBps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maximumLiquidationCount": {
          "type": "integer",
          "minimum": 0
        },
        "maximumMandateBreachCount": {
          "type": "integer",
          "minimum": 0
        },
        "maximumSevereAnomalyCount": {
          "type": "integer",
          "minimum": 0
        },
        "minimumCompletedOutcomesForChallenger": {
          "type": "integer",
          "minimum": 1
        },
        "challengerDefaultReviewBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceConfidence",
        "alphaQuality",
        "riskReliability",
        "strategyCapacity",
        "mandateCompliance",
        "repaymentHistory"
      ],
      "properties": {
        "evidenceConfidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "alphaQuality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "riskReliability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "strategyCapacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "mandateCompliance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "repaymentHistory": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "capacityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equityP10MultiplierBps",
        "positiveNetPnlMultiplierBps"
      ],
      "properties": {
        "equityP10MultiplierBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "positiveNetPnlMultiplierBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "challengerPrior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultCount", "nonDefaultCount"],
      "properties": {
        "defaultCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "nonDefaultCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "featureSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "netRealizedPnlMinor",
        "positiveFillRateBps",
        "observationCount",
        "equityP10Minor",
        "maximumDrawdownBps",
        "p95LeverageBps",
        "positivePeriodRateBps",
        "liquidationCount",
        "mandateBreachCount",
        "severeAnomalyCount",
        "priorCompletedOutcomeCount",
        "priorDefaultRateBps",
        "priorLateOrModifiedRateBps",
        "pointInTimeAt",
        "futureOutcomeDataIncluded",
        "schemaVersion",
        "compositeScoreBps"
      ],
      "properties": {
        "netRealizedPnlMinor": {
          "oneOf": [
            { "$ref": "#/$defs/minor" },
            { "type": "string", "pattern": "^-[1-9][0-9]{0,77}$" },
            { "type": "null" }
          ]
        },
        "positiveFillRateBps": { "$ref": "#/$defs/nullableBps" },
        "observationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "equityP10Minor": {
          "oneOf": [
            { "$ref": "#/$defs/minor" },
            { "type": "null" }
          ]
        },
        "maximumDrawdownBps": { "$ref": "#/$defs/nullableBps" },
        "p95LeverageBps": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            { "type": "null" }
          ]
        },
        "positivePeriodRateBps": { "$ref": "#/$defs/nullableBps" },
        "liquidationCount": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 1000000 },
            { "type": "null" }
          ]
        },
        "mandateBreachCount": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 1000000 },
            { "type": "null" }
          ]
        },
        "severeAnomalyCount": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 3 },
            { "type": "null" }
          ]
        },
        "priorCompletedOutcomeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "priorDefaultRateBps": { "$ref": "#/$defs/nullableBps" },
        "priorLateOrModifiedRateBps": {
          "$ref": "#/$defs/nullableBps"
        },
        "pointInTimeAt": { "type": "string", "format": "date-time" },
        "futureOutcomeDataIncluded": { "const": false },
        "schemaVersion": { "const": "trading_credit_feature_snapshot.v1" },
        "compositeScoreBps": { "$ref": "#/$defs/nullableBps" }
      }
    },
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factorId",
        "scoreBps",
        "weightBps",
        "includedInComposite",
        "reasonCodes",
        "authorizing",
        "schemaVersion"
      ],
      "properties": {
        "factorId": {
          "enum": [
            "evidence_confidence",
            "alpha_quality",
            "risk_reliability",
            "strategy_capacity",
            "mandate_compliance",
            "repayment_history"
          ]
        },
        "scoreBps": { "$ref": "#/$defs/nullableBps" },
        "weightBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "includedInComposite": { "type": "boolean" },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reasonCode" }
        },
        "authorizing": { "const": false },
        "schemaVersion": {
          "const": "trading_credit_factor_assessment.v1"
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productCapMinor",
        "equityP10ConstraintMinor",
        "positiveNetPnlConstraintMinor",
        "repaymentCashflowConstraintMinor",
        "grossLimitMinor",
        "currentOutstandingMinor",
        "recommendedLimitMinor",
        "authorizing",
        "schemaVersion"
      ],
      "properties": {
        "productCapMinor": { "$ref": "#/$defs/minor" },
        "equityP10ConstraintMinor": {
          "oneOf": [
            { "$ref": "#/$defs/minor" },
            { "type": "null" }
          ]
        },
        "positiveNetPnlConstraintMinor": {
          "oneOf": [
            { "$ref": "#/$defs/minor" },
            { "type": "null" }
          ]
        },
        "repaymentCashflowConstraintMinor": {
          "oneOf": [
            { "$ref": "#/$defs/minor" },
            { "type": "null" }
          ]
        },
        "grossLimitMinor": { "$ref": "#/$defs/minor" },
        "currentOutstandingMinor": { "$ref": "#/$defs/minor" },
        "recommendedLimitMinor": { "$ref": "#/$defs/minor" },
        "authorizing": { "const": false },
        "schemaVersion": {
          "const": "trading_credit_capacity_recommendation.v1"
        }
      }
    },
    "proofBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRoot",
        "sourceEvidenceHashes",
        "featureSnapshotHash",
        "policyHash",
        "assessmentHash",
        "creditStateHash",
        "hashAlgorithm",
        "hashDomain",
        "bytes32Compatible",
        "onchainRecomputationClaimed",
        "verificationMode",
        "schemaVersion"
      ],
      "properties": {
        "evidenceRoot": { "$ref": "#/$defs/hash" },
        "sourceEvidenceHashes": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hash" }
        },
        "featureSnapshotHash": { "$ref": "#/$defs/hash" },
        "policyHash": { "$ref": "#/$defs/hash" },
        "assessmentHash": { "$ref": "#/$defs/hash" },
        "creditStateHash": { "$ref": "#/$defs/hash" },
        "hashAlgorithm": { "const": "sha3-256" },
        "hashDomain": { "const": "IPO_ONE_DEMO_V1" },
        "bytes32Compatible": { "const": true },
        "onchainRecomputationClaimed": { "const": false },
        "verificationMode": {
          "const": "offchain_recompute_plus_testnet_anchor"
        },
        "schemaVersion": { "const": "trading_credit_proof_bundle.v1" }
      }
    }
  }
}
