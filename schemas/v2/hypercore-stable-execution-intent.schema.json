{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/hypercore-stable-execution-intent.schema.json",
  "title": "HyperCore Stable Execution Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intentId", "intentHash", "economicActionHash", "idempotencyKeyHash",
    "facilityId", "facilityHash", "accountBindingId", "accountBindingHash",
    "canonicalAccountAddressHash", "handoffId", "handoffHash", "delegateId",
    "delegateHash", "apiWalletAddressHash", "signerReferenceHash",
    "policyConstraintHash", "payloadHash", "actionKind", "hyperliquidAction",
    "nonce", "preparedAt", "approvalExpiresAt", "state", "version",
    "founderApprovalId", "founderApprovalHash", "humanConfirmationHash",
    "preflightReceiptId", "preflightReceiptHash", "riskSnapshotHash", "metadataHash",
    "signingRequestHash", "actionAuthorizationHash", "requestBodyHash",
    "signatureHash", "claimHash", "disposition", "responseHash",
    "reconciliationHash", "venueOrderStateHash", "venueAccountStateHash",
    "ledgerStateHash", "obligationEvidenceHash", "signerRetirementHash",
    "approvedAt", "signingStartedAt", "claimedAt", "resolvedAt", "reconciledAt",
    "closedAt", "externalSubmissionAttempted", "retryAllowed", "rawActionPersisted",
    "rawResponsePersisted", "rawKeyPersisted", "rawSignaturePersisted",
    "exactExecutionOnly", "oneUse", "mainnetAuthority", "productionAuthority",
    "realFundsAuthority", "schemaVersion"
  ],
  "properties": {
    "intentId": { "$ref": "#/$defs/identifier" },
    "intentHash": { "$ref": "#/$defs/hash" },
    "economicActionHash": { "$ref": "#/$defs/hash" },
    "idempotencyKeyHash": { "$ref": "#/$defs/hash" },
    "facilityId": { "$ref": "#/$defs/identifier" },
    "facilityHash": { "$ref": "#/$defs/hash" },
    "accountBindingId": { "$ref": "#/$defs/identifier" },
    "accountBindingHash": { "$ref": "#/$defs/hash" },
    "canonicalAccountAddressHash": { "$ref": "#/$defs/hash" },
    "handoffId": { "$ref": "#/$defs/identifier" },
    "handoffHash": { "$ref": "#/$defs/hash" },
    "delegateId": { "$ref": "#/$defs/identifier" },
    "delegateHash": { "$ref": "#/$defs/hash" },
    "apiWalletAddressHash": { "$ref": "#/$defs/hash" },
    "signerReferenceHash": { "$ref": "#/$defs/hash" },
    "policyConstraintHash": { "$ref": "#/$defs/hash" },
    "payloadHash": { "$ref": "#/$defs/hash" },
    "actionKind": { "const": "order" },
    "hyperliquidAction": { "$ref": "#/$defs/action" },
    "nonce": { "type": "integer", "minimum": 1 },
    "preparedAt": { "type": "string", "format": "date-time" },
    "approvalExpiresAt": { "type": "string", "format": "date-time" },
    "state": {
      "enum": ["PREPARED", "APPROVED", "SIGNING", "SUBMITTING", "SUBMITTED",
        "REJECTED", "UNKNOWN", "RECONCILED", "CLOSED", "ABORTED"]
    },
    "version": { "type": "integer", "minimum": 1, "maximum": 7 },
    "founderApprovalId": { "$ref": "#/$defs/nullableIdentifier" },
    "founderApprovalHash": { "$ref": "#/$defs/nullableHash" },
    "humanConfirmationHash": { "$ref": "#/$defs/nullableHash" },
    "preflightReceiptId": { "$ref": "#/$defs/nullableIdentifier" },
    "preflightReceiptHash": { "$ref": "#/$defs/nullableHash" },
    "riskSnapshotHash": { "$ref": "#/$defs/nullableHash" },
    "metadataHash": { "$ref": "#/$defs/nullableHash" },
    "signingRequestHash": { "$ref": "#/$defs/nullableHash" },
    "actionAuthorizationHash": { "$ref": "#/$defs/nullableHash" },
    "requestBodyHash": { "$ref": "#/$defs/nullableHash" },
    "signatureHash": { "$ref": "#/$defs/nullableHash" },
    "claimHash": { "$ref": "#/$defs/nullableHash" },
    "disposition": { "enum": [null, "confirmed", "rejected", "unknown"] },
    "responseHash": { "$ref": "#/$defs/nullableHash" },
    "reconciliationHash": { "$ref": "#/$defs/nullableHash" },
    "venueOrderStateHash": { "$ref": "#/$defs/nullableHash" },
    "venueAccountStateHash": { "$ref": "#/$defs/nullableHash" },
    "ledgerStateHash": { "$ref": "#/$defs/nullableHash" },
    "obligationEvidenceHash": { "$ref": "#/$defs/nullableHash" },
    "signerRetirementHash": { "$ref": "#/$defs/nullableHash" },
    "approvedAt": { "$ref": "#/$defs/nullableTime" },
    "signingStartedAt": { "$ref": "#/$defs/nullableTime" },
    "claimedAt": { "$ref": "#/$defs/nullableTime" },
    "resolvedAt": { "$ref": "#/$defs/nullableTime" },
    "reconciledAt": { "$ref": "#/$defs/nullableTime" },
    "closedAt": { "$ref": "#/$defs/nullableTime" },
    "externalSubmissionAttempted": { "type": "boolean" },
    "retryAllowed": { "const": false },
    "rawActionPersisted": { "const": false },
    "rawResponsePersisted": { "const": false },
    "rawKeyPersisted": { "const": false },
    "rawSignaturePersisted": { "const": false },
    "exactExecutionOnly": { "const": true },
    "oneUse": { "const": true },
    "mainnetAuthority": { "const": false },
    "productionAuthority": { "const": false },
    "realFundsAuthority": { "const": false },
    "schemaVersion": { "const": "hypercore_stable_execution_intent.v2" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "nullableHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "identifier": {
      "type": "string", "minLength": 3, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/%-]*$"
    },
    "nullableIdentifier": {
      "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
    },
    "nullableTime": {
      "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "decimal": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$" },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "orders", "grouping"],
      "properties": {
        "type": { "const": "order" },
        "grouping": { "const": "na" },
        "orders": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["a", "b", "p", "s", "r", "t", "c"],
            "properties": {
              "a": { "const": 3 }, "b": { "type": "boolean" },
              "p": { "$ref": "#/$defs/decimal" }, "s": { "$ref": "#/$defs/decimal" },
              "r": { "const": false },
              "t": {
                "type": "object", "additionalProperties": false,
                "required": ["limit"],
                "properties": {
                  "limit": {
                    "type": "object", "additionalProperties": false,
                    "required": ["tif"], "properties": { "tif": { "const": "Alo" } }
                  }
                }
              },
              "c": { "type": "string", "pattern": "^0x[0-9a-f]{32}$" }
            }
          }
        }
      }
    }
  }
}
