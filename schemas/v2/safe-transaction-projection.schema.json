{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/safe-transaction-projection.schema.json",
  "title": "IPO.ONE Safe Transaction Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "safeTransactionProjectionId", "safeTransactionProjectionHash", "descriptorHash", "capabilitiesHash",
    "capabilityObservationHash", "providerRequestId", "providerRequestHash", "preparedExecutionHash",
    "preflightHash", "accountConfigurationHash", "chainId", "contextEpoch", "safeVersion", "safeNonce",
    "operation", "exactSafeTransactionDataHash", "decision", "reasonCodes", "preparedAt", "expiresAt",
    "canonicalPreflightStillRequired", "thresholdApprovalRequired", "officialSafeTxHashComputed",
    "safeSignaturesCollected", "moduleExecutionAllowed", "delegateCallAllowed", "providerAdjustmentAllowed",
    "transactionServiceUsed", "rawCalldataRetained", "rawSignatureRetained", "externalCallAllowed",
    "submissionAllowed", "productionAuthority", "fundsAuthority", "schemaVersion"
  ],
  "properties": {
    "safeTransactionProjectionId": { "$ref": "#/$defs/identifier" },
    "safeTransactionProjectionHash": { "$ref": "#/$defs/hash" },
    "descriptorHash": { "$ref": "#/$defs/hash" },
    "capabilitiesHash": { "$ref": "#/$defs/hash" },
    "capabilityObservationHash": { "$ref": "#/$defs/hash" },
    "providerRequestId": { "$ref": "#/$defs/identifier" },
    "providerRequestHash": { "$ref": "#/$defs/hash" },
    "preparedExecutionHash": { "$ref": "#/$defs/hash" },
    "preflightHash": { "$ref": "#/$defs/hash" },
    "accountConfigurationHash": { "$ref": "#/$defs/hash" },
    "chainId": { "enum": ["eip155:84532", "eip155:1952"] },
    "contextEpoch": { "type": "integer", "minimum": 0 },
    "safeVersion": { "$ref": "#/$defs/version" },
    "safeNonce": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,77})$" },
    "operation": { "enum": ["CALL", "DELEGATECALL"] },
    "exactSafeTransactionDataHash": { "$ref": "#/$defs/hash" },
    "decision": { "enum": ["STEP_UP", "DENY", "QUARANTINE"] },
    "reasonCodes": { "$ref": "#/$defs/reasonCodes" },
    "preparedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "canonicalPreflightStillRequired": { "const": true },
    "thresholdApprovalRequired": { "const": true },
    "officialSafeTxHashComputed": { "const": false },
    "safeSignaturesCollected": { "const": false },
    "moduleExecutionAllowed": { "const": false },
    "delegateCallAllowed": { "const": false },
    "providerAdjustmentAllowed": { "const": false },
    "transactionServiceUsed": { "const": false },
    "rawCalldataRetained": { "const": false },
    "rawSignatureRetained": { "const": false },
    "externalCallAllowed": { "const": false },
    "submissionAllowed": { "const": false },
    "productionAuthority": { "const": false },
    "fundsAuthority": { "const": false },
    "schemaVersion": { "const": "safe_transaction_projection.v1" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/%-]*$"
    },
    "version": {
      "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "reasonCodes": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$" }
    }
  }
}
