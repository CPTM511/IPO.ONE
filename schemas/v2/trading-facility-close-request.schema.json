{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/trading-facility-close-request.schema.json",
  "title": "IPO.ONE Trading Facility Close Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tradingFacilityCloseRequestId",
    "requestHash",
    "facilityId",
    "facilityHash",
    "facilityStateHash",
    "facilityVersion",
    "obligationId",
    "obligationHash",
    "subjectId",
    "principalId",
    "providerId",
    "subjectActorHash",
    "providerActorHash",
    "requestedByActorHash",
    "reasonCode",
    "status",
    "immutable",
    "requestedAt",
    "version",
    "closePolicyVersion",
    "sandboxOnly",
    "syntheticOnly",
    "nonRedeemable",
    "withdrawable",
    "transferable",
    "externalSystemQueried",
    "externalOrderSubmitted",
    "productionAuthority",
    "fundsAuthority",
    "realCollateral",
    "realFunding",
    "realEquity",
    "realPricing",
    "productionFundsMoved",
    "piiIncluded",
    "secretsIncluded",
    "schemaVersion"
  ],
  "properties": {
    "tradingFacilityCloseRequestId": { "$ref": "#/$defs/id" },
    "requestHash": { "$ref": "#/$defs/hash" },
    "facilityId": { "$ref": "#/$defs/id" },
    "facilityHash": { "$ref": "#/$defs/hash" },
    "facilityStateHash": { "$ref": "#/$defs/hash" },
    "facilityVersion": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "obligationId": { "$ref": "#/$defs/id" },
    "obligationHash": { "$ref": "#/$defs/hash" },
    "subjectId": { "$ref": "#/$defs/id" },
    "principalId": { "$ref": "#/$defs/id" },
    "providerId": { "$ref": "#/$defs/id" },
    "subjectActorHash": { "$ref": "#/$defs/hash" },
    "providerActorHash": { "$ref": "#/$defs/hash" },
    "requestedByActorHash": { "$ref": "#/$defs/hash" },
    "reasonCode": { "const": "operator_request" },
    "status": { "const": "requested" },
    "immutable": { "const": true },
    "requestedAt": { "type": "string", "format": "date-time" },
    "version": { "const": 1 },
    "closePolicyVersion": {
      "const": "trading_no_funds_conservation_settlement_policy.v1"
    },
    "sandboxOnly": { "const": true },
    "syntheticOnly": { "const": true },
    "nonRedeemable": { "const": true },
    "withdrawable": { "const": false },
    "transferable": { "const": false },
    "externalSystemQueried": { "const": false },
    "externalOrderSubmitted": { "const": false },
    "productionAuthority": { "const": false },
    "fundsAuthority": { "const": false },
    "realCollateral": { "const": false },
    "realFunding": { "const": false },
    "realEquity": { "const": false },
    "realPricing": { "const": false },
    "productionFundsMoved": { "const": false },
    "piiIncluded": { "const": false },
    "secretsIncluded": { "const": false },
    "schemaVersion": { "const": "trading_facility_close_request.v1" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
  }
}
