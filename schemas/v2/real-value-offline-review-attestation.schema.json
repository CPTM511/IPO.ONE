{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/real-value-offline-review-attestation.schema.json",
  "title": "IPO.ONE real-value offline human review attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attestationId",
    "packageId",
    "packageSha256",
    "reviewedDecisionIds",
    "reviewer",
    "opinion",
    "conditions",
    "evidenceRefs",
    "sourceRecord",
    "reviewedAt",
    "expiresAt",
    "founderCustodyReceipt",
    "approvalEffect",
    "authority"
  ],
  "properties": {
    "schemaVersion": {
      "const": "real_value_offline_review_attestation.v1"
    },
    "attestationId": {
      "type": "string",
      "pattern": "^REALVALUE-001-OFFLINE-[0-9]{3}$"
    },
    "packageId": {
      "const": "REALVALUE-001-DECISION-PACKAGE-001"
    },
    "packageSha256": {
      "const": "13eb17bdca90258bff27943b8be36516f5ebeead5855d28d23ba2cbe03ff4723"
    },
    "reviewedDecisionIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^RV-P0-(?:0[1-9]|1[0-6])$"
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerRef",
        "role",
        "identityHeldOfflineBy",
        "onlineAccountRequired",
        "independenceClaim"
      ],
      "properties": {
        "reviewerRef": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "$ref": "#/$defs/text"
        },
        "identityHeldOfflineBy": {
          "const": "IPO.ONE Founder"
        },
        "onlineAccountRequired": {
          "const": false
        },
        "independenceClaim": {
          "enum": [
            "NOT_REQUIRED",
            "CLAIMED_IN_SOURCE_RECORD"
          ]
        }
      }
    },
    "opinion": {
      "enum": [
        "APPROVE",
        "REJECT",
        "REVISE_REQUIRED"
      ]
    },
    "conditions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "sha256",
        "custodyLocationRef",
        "containsSecretOrCredential",
        "containsRawPiiInRepository"
      ],
      "properties": {
        "format": {
          "enum": [
            "SIGNED_PAPER",
            "SIGNED_PDF",
            "MEETING_MINUTES",
            "EMAIL_EXPORT",
            "OTHER_OFFLINE_RECORD"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "custodyLocationRef": {
          "$ref": "#/$defs/identifier"
        },
        "containsSecretOrCredential": {
          "const": false
        },
        "containsRawPiiInRepository": {
          "const": false
        }
      }
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "founderCustodyReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custodianRole",
        "receivedAt",
        "sourceHashVerified",
        "faithfullyTranscribed",
        "conflictsDisclosed"
      ],
      "properties": {
        "custodianRole": {
          "const": "IPO.ONE Founder"
        },
        "receivedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceHashVerified": {
          "const": true
        },
        "faithfullyTranscribed": {
          "const": true
        },
        "conflictsDisclosed": {
          "type": "boolean"
        }
      }
    },
    "approvalEffect": {
      "const": "NONE_UNTIL_DECISION_PACKAGE_UPDATED_AND_REVALIDATED"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launchAllowed",
        "launchPolicyRevisionAuthorized",
        "realFundsAuthorized",
        "mainnetAuthorized",
        "productionSignerAuthorized",
        "exchangeWriteAuthorized",
        "deploymentAuthorized",
        "capitalMovementAuthorized"
      ],
      "properties": {
        "launchAllowed": {
          "const": false
        },
        "launchPolicyRevisionAuthorized": {
          "const": false
        },
        "realFundsAuthorized": {
          "const": false
        },
        "mainnetAuthorized": {
          "const": false
        },
        "productionSignerAuthorized": {
          "const": false
        },
        "exchangeWriteAuthorized": {
          "const": false
        },
        "deploymentAuthorized": {
          "const": false
        },
        "capitalMovementAuthorized": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "sha256",
        "custodyLocationRef"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/text"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "custodyLocationRef": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
