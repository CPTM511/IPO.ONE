{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/safe-account-configuration-comparison.schema.json",
  "title": "IPO.ONE Safe Account Configuration Comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparisonHash", "safeTransactionProjectionHash", "currentObservationHash",
    "expectedConfigurationHash", "currentConfigurationHash", "contextEpoch", "configurationMatches",
    "decision", "reasonCodes", "comparedAt", "expiresAt", "externalCallPerformed",
    "submissionAllowed", "productionAuthority", "fundsAuthority", "schemaVersion"
  ],
  "properties": {
    "comparisonHash": { "$ref": "#/$defs/hash" },
    "safeTransactionProjectionHash": { "$ref": "#/$defs/hash" },
    "currentObservationHash": { "$ref": "#/$defs/hash" },
    "expectedConfigurationHash": { "$ref": "#/$defs/hash" },
    "currentConfigurationHash": { "$ref": "#/$defs/hash" },
    "contextEpoch": { "type": "integer", "minimum": 0 },
    "configurationMatches": { "type": "boolean" },
    "decision": { "enum": ["STEP_UP", "DENY", "QUARANTINE"] },
    "reasonCodes": { "$ref": "#/$defs/reasonCodes" },
    "comparedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "externalCallPerformed": { "const": false },
    "submissionAllowed": { "const": false },
    "productionAuthority": { "const": false },
    "fundsAuthority": { "const": false },
    "schemaVersion": { "const": "safe_account_configuration_comparison.v1" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "reasonCodes": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$" }
    }
  }
}
