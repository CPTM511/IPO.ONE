{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/wallet-signature-verification.schema.json",
  "title": "IPO.ONE wallet signature verification result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "accountHash",
    "blockNumber",
    "blockHash",
    "chainId",
    "providerSlot",
    "sourceFinality",
    "walletType",
    "signatureType",
    "verificationMethod",
    "challengeReferenceHash",
    "signatureReferenceHash",
    "authenticationEligible",
    "rawSignaturePersisted",
    "credentialsIncluded",
    "productionFundsMoved"
  ],
  "properties": {
    "schemaVersion": { "const": "wallet_signature_verification.v1" },
    "accountHash": { "$ref": "#/$defs/hash" },
    "blockNumber": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "blockHash": { "$ref": "#/$defs/hash" },
    "chainId": {
      "enum": ["eip155:84532", "eip155:1952"]
    },
    "providerSlot": {
      "enum": ["primary", "secondary"]
    },
    "sourceFinality": {
      "enum": ["safe", "inclusion_only"]
    },
    "walletType": {
      "enum": ["eoa", "contract", "counterfactual"]
    },
    "signatureType": {
      "enum": ["eoa", "erc1271", "erc6492"]
    },
    "verificationMethod": {
      "enum": [
        "eip191_eoa_v1",
        "eip1271_eip191_v1",
        "eip712_eoa_v1",
        "eip1271_eip712_v1",
        "eip6492_eip191_v1",
        "eip6492_eip712_v1"
      ]
    },
    "challengeReferenceHash": { "$ref": "#/$defs/hash" },
    "signatureReferenceHash": { "$ref": "#/$defs/hash" },
    "authenticationEligible": { "type": "boolean" },
    "rawSignaturePersisted": { "const": false },
    "credentialsIncluded": { "const": false },
    "productionFundsMoved": { "const": false }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    }
  }
}
