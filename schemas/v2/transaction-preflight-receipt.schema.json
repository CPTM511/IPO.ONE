{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/transaction-preflight-receipt.schema.json",
  "title": "TransactionPreflightReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preflightReceiptId", "preflightHash", "executionId",
    "preparedExecutionHash", "authorizationHash", "grantId", "grantHash",
    "exactPayloadHash", "targetSnapshot", "simulationSnapshot",
    "expectedEffectsHash", "simulatedEffectsHash", "allowanceDeltaHash",
    "assetDeltaHash", "riskChecksHash", "reservationHash", "decision",
    "reasonCodes", "createdAt", "expiresAt", "transactionsAllowed",
    "sandboxOnly", "productionAuthority", "fundsAuthority", "schemaVersion"
  ],
  "properties": {
    "preflightReceiptId": { "$ref": "prepared-execution.schema.json#/$defs/id" },
    "preflightHash": { "$ref": "prepared-execution.schema.json#/$defs/hash" },
    "executionId": { "$ref": "prepared-execution.schema.json#/$defs/id" },
    "preparedExecutionHash": { "$ref": "prepared-execution.schema.json#/$defs/hash" },
    "authorizationHash": { "$ref": "prepared-execution.schema.json#/$defs/hash" },
    "grantId": { "$ref": "prepared-execution.schema.json#/$defs/id" },
    "grantHash": { "$ref": "prepared-execution.schema.json#/$defs/hash" },
    "exactPayloadHash": { "$ref": "prepared-execution.schema.json#/$defs/hash" },
    "targetSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["chainId", "targetAddress", "functionSelector", "codeHash", "proxyImplementationHash", "targetPolicyHash"],
      "properties": {
        "chainId": { "enum": ["eip155:84532", "eip155:1952"] },
        "targetAddress": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
        "functionSelector": { "type": "string", "pattern": "^0x[0-9a-f]{8}$" },
        "codeHash": { "$ref": "prepared-execution.schema.json#/$defs/hash" },
        "proxyImplementationHash": { "oneOf": [{ "type": "null" }, { "$ref": "prepared-execution.schema.json#/$defs/hash" }] },
        "targetPolicyHash": { "$ref": "prepared-execution.schema.json#/$defs/hash" }
      }
    },
    "simulationSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["simulationReportId", "simulationHash", "blockNumber", "blockHash"],
      "properties": {
        "simulationReportId": { "$ref": "prepared-execution.schema.json#/$defs/id" },
        "simulationHash": { "$ref": "prepared-execution.schema.json#/$defs/hash" },
        "blockNumber": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,19})$" },
        "blockHash": { "$ref": "prepared-execution.schema.json#/$defs/hash" }
      }
    },
    "expectedEffectsHash": { "$ref": "prepared-execution.schema.json#/$defs/hash" },
    "simulatedEffectsHash": { "$ref": "prepared-execution.schema.json#/$defs/hash" },
    "allowanceDeltaHash": { "$ref": "prepared-execution.schema.json#/$defs/hash" },
    "assetDeltaHash": { "$ref": "prepared-execution.schema.json#/$defs/hash" },
    "riskChecksHash": { "$ref": "prepared-execution.schema.json#/$defs/hash" },
    "reservationHash": { "$ref": "prepared-execution.schema.json#/$defs/hash" },
    "decision": { "enum": ["ALLOW", "STEP_UP", "DENY", "QUARANTINE"] },
    "reasonCodes": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "transactionsAllowed": { "const": false },
    "sandboxOnly": { "const": true },
    "productionAuthority": { "const": false },
    "fundsAuthority": { "const": false },
    "schemaVersion": { "const": "transaction_preflight_receipt.v1" }
  }
}
