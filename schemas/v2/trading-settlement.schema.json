{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/trading-settlement.schema.json",
  "title": "IPO.ONE Trading Settlement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tradingSettlementId",
    "settlementHash",
    "closeRequestId",
    "closeRequestHash",
    "facilityId",
    "facilityHash",
    "facilityStateHashBefore",
    "facilityVersionBefore",
    "facilityStateHashAfter",
    "facilityVersionAfter",
    "obligationId",
    "obligationHash",
    "subjectId",
    "principalId",
    "providerId",
    "assetId",
    "finalSyntheticEquityMinor",
    "subjectContributionMinor",
    "providerContributionMinor",
    "subjectReturnMinor",
    "providerPrincipalReturnMinor",
    "realizedPnlMinor",
    "venueCostMinor",
    "closingCostMinor",
    "fixedReturnMinor",
    "performanceParticipationMinor",
    "ipoOneFeeMinor",
    "totalAllocatedMinor",
    "waterfallBalanced",
    "zeroExposureVerified",
    "canonicalObligationUnchanged",
    "canonicalLedgerMutationCreated",
    "secondLedgerCreated",
    "officialSettlement",
    "status",
    "version",
    "settledByActorHash",
    "settledAt",
    "settlementPolicyVersion",
    "sandboxOnly",
    "syntheticOnly",
    "nonRedeemable",
    "withdrawable",
    "transferable",
    "externalSystemQueried",
    "externalOrderSubmitted",
    "productionAuthority",
    "fundsAuthority",
    "realCollateral",
    "realFunding",
    "realEquity",
    "realPricing",
    "productionFundsMoved",
    "piiIncluded",
    "secretsIncluded",
    "schemaVersion"
  ],
  "properties": {
    "tradingSettlementId": { "$ref": "#/$defs/id" },
    "settlementHash": { "$ref": "#/$defs/hash" },
    "closeRequestId": { "$ref": "#/$defs/id" },
    "closeRequestHash": { "$ref": "#/$defs/hash" },
    "facilityId": { "$ref": "#/$defs/id" },
    "facilityHash": { "$ref": "#/$defs/hash" },
    "facilityStateHashBefore": { "$ref": "#/$defs/hash" },
    "facilityVersionBefore": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "facilityStateHashAfter": { "$ref": "#/$defs/hash" },
    "facilityVersionAfter": { "type": "integer", "minimum": 2, "maximum": 10001 },
    "obligationId": { "$ref": "#/$defs/id" },
    "obligationHash": { "$ref": "#/$defs/hash" },
    "subjectId": { "$ref": "#/$defs/id" },
    "principalId": { "$ref": "#/$defs/id" },
    "providerId": { "$ref": "#/$defs/id" },
    "assetId": { "$ref": "#/$defs/id" },
    "finalSyntheticEquityMinor": { "$ref": "#/$defs/minor" },
    "subjectContributionMinor": { "$ref": "#/$defs/minor" },
    "providerContributionMinor": { "$ref": "#/$defs/minor" },
    "subjectReturnMinor": { "$ref": "#/$defs/minor" },
    "providerPrincipalReturnMinor": { "$ref": "#/$defs/minor" },
    "realizedPnlMinor": { "const": "0" },
    "venueCostMinor": { "const": "0" },
    "closingCostMinor": { "const": "0" },
    "fixedReturnMinor": { "const": "0" },
    "performanceParticipationMinor": { "const": "0" },
    "ipoOneFeeMinor": { "const": "0" },
    "totalAllocatedMinor": { "$ref": "#/$defs/minor" },
    "waterfallBalanced": { "const": true },
    "zeroExposureVerified": { "const": true },
    "canonicalObligationUnchanged": { "const": true },
    "canonicalLedgerMutationCreated": { "const": false },
    "secondLedgerCreated": { "const": false },
    "officialSettlement": { "const": false },
    "status": { "const": "finalized" },
    "version": { "const": 1 },
    "settledByActorHash": { "$ref": "#/$defs/hash" },
    "settledAt": { "type": "string", "format": "date-time" },
    "settlementPolicyVersion": {
      "const": "trading_no_funds_conservation_settlement_policy.v1"
    },
    "sandboxOnly": { "const": true },
    "syntheticOnly": { "const": true },
    "nonRedeemable": { "const": true },
    "withdrawable": { "const": false },
    "transferable": { "const": false },
    "externalSystemQueried": { "const": false },
    "externalOrderSubmitted": { "const": false },
    "productionAuthority": { "const": false },
    "fundsAuthority": { "const": false },
    "realCollateral": { "const": false },
    "realFunding": { "const": false },
    "realEquity": { "const": false },
    "realPricing": { "const": false },
    "productionFundsMoved": { "const": false },
    "piiIncluded": { "const": false },
    "secretsIncluded": { "const": false },
    "schemaVersion": { "const": "trading_settlement.v1" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "minor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 78,
      "pattern": "^(?:0|[1-9][0-9]*)$"
    }
  }
}
