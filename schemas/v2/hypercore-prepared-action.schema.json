{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/hypercore-prepared-action.schema.json",
  "title": "IPO.ONE HyperCore Prepared Action v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preparedActionHash", "actionKind", "signingScheme", "hyperliquidAction",
    "sourceActionHash", "policyDecisionHash", "riskSnapshotHash", "accountBindingHash",
    "delegateHash", "environment", "canonicalFieldOrder", "rawActionAccepted",
    "withdrawalAllowed", "transferAllowed", "leverageChangeAllowed",
    "accountModeChangeAllowed", "externalSubmissionAllowed", "mainnetAuthority",
    "productionAuthority", "fundsAuthority", "schemaVersion"
  ],
  "properties": {
    "preparedActionHash": { "$ref": "#/$defs/hash" },
    "actionKind": { "enum": ["order", "reduceOnlyOrder", "cancel", "cancelByCloid", "modify", "scheduleCancel"] },
    "signingScheme": { "const": "l1_action" },
    "hyperliquidAction": {
      "oneOf": [
        { "$ref": "#/$defs/orderAction" },
        { "$ref": "#/$defs/cancelAction" },
        { "$ref": "#/$defs/cancelByCloidAction" },
        { "$ref": "#/$defs/modifyAction" },
        { "$ref": "#/$defs/scheduleCancelAction" }
      ]
    },
    "sourceActionHash": { "$ref": "#/$defs/hash" },
    "policyDecisionHash": { "$ref": "#/$defs/hash" },
    "riskSnapshotHash": { "$ref": "#/$defs/hash" },
    "accountBindingHash": { "$ref": "#/$defs/hash" },
    "delegateHash": { "$ref": "#/$defs/hash" },
    "environment": { "const": "hyperliquid_testnet" },
    "canonicalFieldOrder": { "const": true },
    "rawActionAccepted": { "const": false },
    "withdrawalAllowed": { "const": false },
    "transferAllowed": { "const": false },
    "leverageChangeAllowed": { "const": false },
    "accountModeChangeAllowed": { "const": false },
    "externalSubmissionAllowed": { "const": false },
    "mainnetAuthority": { "const": false },
    "productionAuthority": { "const": false },
    "fundsAuthority": { "const": false },
    "schemaVersion": { "const": "hypercore_prepared_action.v1" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "decimal": { "type": "string", "pattern": "^(?:0\\.(?:0*[1-9][0-9]*|[0-9]*[1-9]0*)|[1-9][0-9]{0,30}(?:\\.[0-9]{1,18})?)$" },
    "cloid": { "type": "string", "pattern": "^0x[0-9a-f]{32}$" },
    "orderWire": {
      "type": "object", "additionalProperties": false,
      "required": ["a", "b", "p", "s", "r", "t", "c"],
      "properties": {
        "a": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "b": { "type": "boolean" },
        "p": { "$ref": "#/$defs/decimal" },
        "s": { "$ref": "#/$defs/decimal" },
        "r": { "type": "boolean" },
        "t": {
          "type": "object", "additionalProperties": false, "required": ["limit"],
          "properties": {
            "limit": {
              "type": "object", "additionalProperties": false, "required": ["tif"],
              "properties": { "tif": { "enum": ["Alo", "Gtc", "Ioc"] } }
            }
          }
        },
        "c": { "$ref": "#/$defs/cloid" }
      }
    },
    "orderAction": {
      "type": "object", "additionalProperties": false, "required": ["type", "orders", "grouping"],
      "properties": {
        "type": { "const": "order" },
        "orders": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/orderWire" } },
        "grouping": { "const": "na" }
      }
    },
    "cancelAction": {
      "type": "object", "additionalProperties": false, "required": ["type", "cancels"],
      "properties": {
        "type": { "const": "cancel" },
        "cancels": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["a", "o"],
            "properties": {
              "a": { "type": "integer", "minimum": 0, "maximum": 1000000 },
              "o": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "cancelByCloidAction": {
      "type": "object", "additionalProperties": false, "required": ["type", "cancels"],
      "properties": {
        "type": { "const": "cancelByCloid" },
        "cancels": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["asset", "cloid"],
            "properties": {
              "asset": { "type": "integer", "minimum": 0, "maximum": 1000000 },
              "cloid": { "$ref": "#/$defs/cloid" }
            }
          }
        }
      }
    },
    "scheduleCancelAction": {
      "type": "object", "additionalProperties": false, "required": ["type", "time"],
      "properties": {
        "type": { "const": "scheduleCancel" },
        "time": { "type": "integer", "minimum": 1 }
      }
    },
    "modifyAction": {
      "type": "object", "additionalProperties": false, "required": ["type", "modifies"],
      "properties": {
        "type": { "const": "batchModify" },
        "modifies": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["oid", "order"],
            "properties": {
              "oid": { "type": "integer", "minimum": 1 },
              "order": { "$ref": "#/$defs/orderWire" }
            }
          }
        }
      }
    }
  }
}
