{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/credit-offer-v2.schema.json",
  "title": "IPO.ONE Capital Partner Credit Offer v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "creditOfferId",
    "creditOfferHash",
    "termsHash",
    "creditIntentId",
    "subjectId",
    "riskDecisionId",
    "capitalPartnerId",
    "capitalPartnerOperatorId",
    "creditPassportArtifactId",
    "creditPassportArtifactHash",
    "creditPassportArtifactVersion",
    "passportVerificationHash",
    "underwritingSnapshotHash",
    "assetId",
    "facilityLimitMinor",
    "approvedPrincipalMinor",
    "perDrawCapMinor",
    "annualRateBps",
    "originationFeeMinor",
    "repaymentFrequency",
    "installmentCount",
    "firstPaymentAt",
    "maturityAt",
    "permittedPurposeCode",
    "conditions",
    "undrawnRevocationRule",
    "disclosureRef",
    "termsVersion",
    "validUntil",
    "reasonCodes",
    "sandboxOnly",
    "productionFundsApproved",
    "status",
    "createdAt",
    "updatedAt",
    "schemaVersion"
  ],
  "properties": {
    "creditOfferId": { "$ref": "#/$defs/id" },
    "creditOfferHash": { "$ref": "#/$defs/hash" },
    "termsHash": { "$ref": "#/$defs/hash" },
    "creditIntentId": { "$ref": "#/$defs/id" },
    "subjectId": { "$ref": "#/$defs/id" },
    "riskDecisionId": { "$ref": "#/$defs/id" },
    "capitalPartnerId": { "$ref": "#/$defs/id" },
    "capitalPartnerOperatorId": { "$ref": "#/$defs/id" },
    "creditPassportArtifactId": { "$ref": "#/$defs/id" },
    "creditPassportArtifactHash": { "$ref": "#/$defs/hash" },
    "creditPassportArtifactVersion": { "type": "integer", "minimum": 1 },
    "passportVerificationHash": { "$ref": "#/$defs/hash" },
    "underwritingSnapshotHash": { "$ref": "#/$defs/hash" },
    "assetId": { "$ref": "#/$defs/id" },
    "facilityLimitMinor": { "$ref": "#/$defs/minor" },
    "approvedPrincipalMinor": { "$ref": "#/$defs/minor" },
    "perDrawCapMinor": { "$ref": "#/$defs/minor" },
    "annualRateBps": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "originationFeeMinor": { "$ref": "#/$defs/minor" },
    "repaymentFrequency": {
      "enum": ["weekly", "biweekly", "monthly", "end_of_term"]
    },
    "installmentCount": { "type": "integer", "minimum": 1, "maximum": 520 },
    "firstPaymentAt": { "type": "string", "format": "date-time" },
    "maturityAt": { "type": "string", "format": "date-time" },
    "permittedPurposeCode": { "$ref": "#/$defs/code" },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "passport_current_at_acceptance",
          "authority_current_at_acceptance",
          "no_adverse_obligation_at_acceptance"
        ]
      }
    },
    "undrawnRevocationRule": {
      "enum": ["capital_partner_before_acceptance", "irrevocable_until_expiry"]
    },
    "disclosureRef": { "$ref": "#/$defs/id" },
    "termsVersion": { "const": "credit_terms.v2" },
    "validUntil": { "type": "string", "format": "date-time" },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/code" }
    },
    "sandboxOnly": { "const": true },
    "productionFundsApproved": { "const": false },
    "status": {
      "enum": ["offered", "accepted", "declined", "expired", "withdrawn", "superseded"]
    },
    "acceptanceId": { "$ref": "#/$defs/id" },
    "acceptedAt": { "type": "string", "format": "date-time" },
    "supersedingOfferId": { "$ref": "#/$defs/id" },
    "closedAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "schemaVersion": { "const": "credit_offer.v2" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "minor": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
    }
  }
}
