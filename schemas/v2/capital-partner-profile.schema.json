{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/capital-partner-profile.schema.json",
  "title": "IPO.ONE Capital Partner Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capitalPartnerId",
    "organizationRef",
    "displayName",
    "operatorActorId",
    "tenantId",
    "status",
    "invitationOnly",
    "sameTenantOnly",
    "sandboxOnly",
    "productionFundsAuthority",
    "createdAt",
    "updatedAt",
    "profileHash",
    "schemaVersion"
  ],
  "properties": {
    "capitalPartnerId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "organizationRef": { "type": "string", "minLength": 1, "maxLength": 256 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
    "operatorActorId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "status": { "const": "active" },
    "invitationOnly": { "const": true },
    "sameTenantOnly": { "const": true },
    "sandboxOnly": { "const": true },
    "productionFundsAuthority": { "const": false },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "profileHash": { "$ref": "#/$defs/hash" },
    "schemaVersion": { "const": "capital_partner_profile.v1" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    }
  }
}
