{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/metamask-agentic-wallet-capability-observation.schema.json",
  "title": "IPO.ONE MetaMask Agentic Wallet Capability Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observationHash", "adapterId", "descriptorHash", "chainId", "chainIdHex", "contextEpoch",
    "rpcMethodSupport", "permissionTypes", "agentWalletSecurity", "source", "observedAt", "expiresAt",
    "unknownIsNonPermissive", "externalCallPerformed", "authorizationGranted", "fundsAuthority", "schemaVersion"
  ],
  "properties": {
    "observationHash": { "$ref": "#/$defs/hash" },
    "adapterId": { "const": "metamask_agent_wallet_reference" },
    "descriptorHash": { "$ref": "#/$defs/hash" },
    "chainId": { "enum": ["eip155:84532", "eip155:1952"] },
    "chainIdHex": { "enum": ["0x14a34", "0x7a0"] },
    "contextEpoch": { "type": "integer", "minimum": 0 },
    "rpcMethodSupport": { "$ref": "#/$defs/rpcMethodSupport" },
    "permissionTypes": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/permissionType" }
    },
    "agentWalletSecurity": { "$ref": "#/$defs/agentWalletSecurity" },
    "source": { "const": "local_synthetic_fixture" },
    "observedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "unknownIsNonPermissive": { "const": true },
    "externalCallPerformed": { "const": false },
    "authorizationGranted": { "const": false },
    "fundsAuthority": { "const": false },
    "schemaVersion": { "const": "metamask_agentic_wallet_capability_observation.v1" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "status": { "enum": ["supported", "unsupported", "unknown"] },
    "rpcMethodSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wallet_getSupportedExecutionPermissions", "wallet_requestExecutionPermissions",
        "wallet_getGrantedExecutionPermissions", "wallet_revokeExecutionPermission"
      ],
      "properties": {
        "wallet_getSupportedExecutionPermissions": { "$ref": "#/$defs/status" },
        "wallet_requestExecutionPermissions": { "$ref": "#/$defs/status" },
        "wallet_getGrantedExecutionPermissions": { "$ref": "#/$defs/status" },
        "wallet_revokeExecutionPermission": { "$ref": "#/$defs/status" }
      }
    },
    "permissionType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "chainIds", "ruleTypes"],
      "properties": {
        "type": { "$ref": "#/$defs/identifier" },
        "chainIds": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^0x(?:0|[1-9a-f][0-9a-f]*)$" }
        },
        "ruleTypes": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "agentWalletSecurity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simulation", "threatScanning", "asyncApproval"],
      "properties": {
        "simulation": { "$ref": "#/$defs/status" },
        "threatScanning": { "$ref": "#/$defs/status" },
        "asyncApproval": { "$ref": "#/$defs/status" }
      }
    },
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/%-]*$"
    }
  }
}
