{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/tenant-metered-usage-admitted.schema.json",
  "title": "IPO.ONE Tenant Metered Usage Admitted v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence", "admission", "spendRequestId", "ledgerTransactionId",
    "obligationId", "facilityId", "nextAction", "sandboxOnly",
    "productionFundsMoved", "schemaVersion"
  ],
  "properties": {
    "evidence": { "$ref": "https://schemas.ipo.one/v2/metered-usage-evidence.schema.json" },
    "admission": { "$ref": "https://schemas.ipo.one/v2/metered-usage-admission.schema.json" },
    "spendRequestId": {
      "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
    },
    "ledgerTransactionId": { "$ref": "#/$defs/identifier" },
    "obligationId": { "$ref": "#/$defs/identifier" },
    "facilityId": { "$ref": "#/$defs/identifier" },
    "nextAction": { "const": "review_metered_usage_receipt" },
    "sandboxOnly": { "const": true },
    "productionFundsMoved": { "const": false },
    "schemaVersion": { "const": "tenant_metered_usage_admitted.v1" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/%-]{0,255}$"
    }
  }
}
