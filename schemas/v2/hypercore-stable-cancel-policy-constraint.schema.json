{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/hypercore-stable-cancel-policy-constraint.schema.json",
  "title": "HyperCore Stable Cancel Policy Constraint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyConstraintHash", "policyId", "policyVersion", "facilityHash",
    "accountBindingHash", "delegateHash", "signerReferenceHash",
    "parentIntentHash", "targetOrderHash", "targetClientOrderId", "environment",
    "market", "productClass", "assetIndex", "actionKind", "expectedOpenOrders",
    "maxPositionNotionalUsd", "maxAggregateProofExposureUsd", "maxSubmissions",
    "maxRiskAgeMs", "maxMetadataAgeMs", "requestExpiryMs",
    "executionOwnerActorId", "riskOwnerActorId", "incidentOwnerActorId",
    "withdrawalAuthority", "transferAuthority", "leverageChangeAuthority",
    "accountAdministrationAuthority", "mainnetAuthority", "productionAuthority",
    "realFundsAuthority", "schemaVersion"
  ],
  "properties": {
    "policyConstraintHash": { "$ref": "#/$defs/hash" },
    "policyId": { "$ref": "#/$defs/id" },
    "policyVersion": { "$ref": "#/$defs/id" },
    "facilityHash": { "$ref": "#/$defs/hash" },
    "accountBindingHash": { "$ref": "#/$defs/hash" },
    "delegateHash": { "$ref": "#/$defs/hash" },
    "signerReferenceHash": { "$ref": "#/$defs/hash" },
    "parentIntentHash": { "$ref": "#/$defs/hash" },
    "targetOrderHash": { "$ref": "#/$defs/hash" },
    "targetClientOrderId": { "const": "0x3ec931145cbe6e36213621b50521a704" },
    "environment": { "const": "hyperliquid_testnet" },
    "market": { "const": "BTC" },
    "productClass": { "const": "perpetual" },
    "assetIndex": { "const": 3 },
    "actionKind": { "const": "cancelByCloid" },
    "expectedOpenOrders": { "const": 1 },
    "maxPositionNotionalUsd": { "const": "0" },
    "maxAggregateProofExposureUsd": { "const": "10" },
    "maxSubmissions": { "const": 1 },
    "maxRiskAgeMs": { "const": 10000 },
    "maxMetadataAgeMs": { "const": 300000 },
    "requestExpiryMs": { "const": 30000 },
    "executionOwnerActorId": { "$ref": "#/$defs/id" },
    "riskOwnerActorId": { "$ref": "#/$defs/id" },
    "incidentOwnerActorId": { "$ref": "#/$defs/id" },
    "withdrawalAuthority": { "const": false },
    "transferAuthority": { "const": false },
    "leverageChangeAuthority": { "const": false },
    "accountAdministrationAuthority": { "const": false },
    "mainnetAuthority": { "const": false },
    "productionAuthority": { "const": false },
    "realFundsAuthority": { "const": false },
    "schemaVersion": { "const": "hypercore_stable_cancel_policy_constraint.v1" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "id": { "type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/%-]*$" }
  }
}
