{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ipo.one/v2/trading-performance-proof.schema.json",
  "title": "IPO.ONE Trading Performance Proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tradingPerformanceProofId",
    "proofHash",
    "settlementId",
    "settlementHash",
    "facilityId",
    "facilityHash",
    "obligationId",
    "obligationHash",
    "subjectId",
    "principalId",
    "providerId",
    "claims",
    "claimSetHash",
    "status",
    "proofVersion",
    "revocable",
    "revoked",
    "externalVerificationAvailable",
    "officialReport",
    "universalScore",
    "strategyDataIncluded",
    "rawHistoryIncluded",
    "issuedByActorHash",
    "issuedAt",
    "expiresAt",
    "proofPolicyVersion",
    "sandboxOnly",
    "syntheticOnly",
    "nonRedeemable",
    "withdrawable",
    "transferable",
    "externalSystemQueried",
    "externalOrderSubmitted",
    "productionAuthority",
    "fundsAuthority",
    "realCollateral",
    "realFunding",
    "realEquity",
    "realPricing",
    "productionFundsMoved",
    "piiIncluded",
    "secretsIncluded",
    "schemaVersion"
  ],
  "properties": {
    "tradingPerformanceProofId": { "$ref": "#/$defs/id" },
    "proofHash": { "$ref": "#/$defs/hash" },
    "settlementId": { "$ref": "#/$defs/id" },
    "settlementHash": { "$ref": "#/$defs/hash" },
    "facilityId": { "$ref": "#/$defs/id" },
    "facilityHash": { "$ref": "#/$defs/hash" },
    "obligationId": { "$ref": "#/$defs/id" },
    "obligationHash": { "$ref": "#/$defs/hash" },
    "subjectId": { "$ref": "#/$defs/id" },
    "principalId": { "$ref": "#/$defs/id" },
    "providerId": { "$ref": "#/$defs/id" },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facilityFinalized",
        "zeroExposure",
        "contributionConservation",
        "canonicalObligationLinked",
        "realProfitClaimed",
        "finalSyntheticEquityMinor",
        "subjectReturnMinor",
        "providerPrincipalReturnMinor",
        "realizedPnlMinor",
        "ipoOneFeeMinor"
      ],
      "properties": {
        "facilityFinalized": { "const": true },
        "zeroExposure": { "const": true },
        "contributionConservation": { "const": true },
        "canonicalObligationLinked": { "const": true },
        "realProfitClaimed": { "const": false },
        "finalSyntheticEquityMinor": { "$ref": "#/$defs/minor" },
        "subjectReturnMinor": { "$ref": "#/$defs/minor" },
        "providerPrincipalReturnMinor": { "$ref": "#/$defs/minor" },
        "realizedPnlMinor": { "const": "0" },
        "ipoOneFeeMinor": { "const": "0" }
      }
    },
    "claimSetHash": { "$ref": "#/$defs/hash" },
    "status": { "const": "active" },
    "proofVersion": { "const": 1 },
    "revocable": { "const": true },
    "revoked": { "const": false },
    "externalVerificationAvailable": { "const": false },
    "officialReport": { "const": false },
    "universalScore": { "const": false },
    "strategyDataIncluded": { "const": false },
    "rawHistoryIncluded": { "const": false },
    "issuedByActorHash": { "$ref": "#/$defs/hash" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "proofPolicyVersion": { "const": "trading_performance_proof_policy.v1" },
    "sandboxOnly": { "const": true },
    "syntheticOnly": { "const": true },
    "nonRedeemable": { "const": true },
    "withdrawable": { "const": false },
    "transferable": { "const": false },
    "externalSystemQueried": { "const": false },
    "externalOrderSubmitted": { "const": false },
    "productionAuthority": { "const": false },
    "fundsAuthority": { "const": false },
    "realCollateral": { "const": false },
    "realFunding": { "const": false },
    "realEquity": { "const": false },
    "realPricing": { "const": false },
    "productionFundsMoved": { "const": false },
    "piiIncluded": { "const": false },
    "secretsIncluded": { "const": false },
    "schemaVersion": { "const": "trading_performance_proof.v1" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "minor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 78,
      "pattern": "^(?:0|[1-9][0-9]*)$"
    }
  }
}
