{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "corepack enable && corepack prepare pnpm@11.1.3 --activate && pnpm install --frozen-lockfile",
  "fluid": true,
  "functions": {
    "api/vercel-sandbox.mjs": {
      "includeFiles": "{apps/web/src/**,db/migrations/**}",
      "maxDuration": 30
    },
    "api/vercel-sandbox-cron.mjs": {
      "includeFiles": "db/migrations/**",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ipo.one"
        }
      ],
      "destination": "https://ipo.one/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/cron",
      "destination": "/api/vercel-sandbox-cron"
    },
    {
      "source": "/(.*)",
      "destination": "/api/vercel-sandbox"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/5 * * * *"
    }
  ]
}
