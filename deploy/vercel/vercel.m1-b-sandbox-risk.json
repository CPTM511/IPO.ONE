{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "fluid": true,
  "functions": {
    "api/vercel-sandbox.mjs": {
      "includeFiles": "{apps/web/src/**,db/migrations/**,deployment-artifact-manifest.json}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/vercel-sandbox"
    }
  ]
}
